 //   and the precompiler only tries the mutex, and only while no core is announced, so a core
 //   waits for at most the one block being emitted.
+// Cores share only when they share an address space and link blocks without cycle counting.
+static bool EdenShares(const UserConfig& conf) {
+    return eden_jit_shared && conf.page_table && !conf.enable_cycle_counting;
+}
+
+// Lichii's host call/return (BL/BLR as host calls, RET as a host return) and compact block exits
+// link a block through sites only the emitter that compiled it patches, from its own block list;
+// in a shared group a block's links are the group's (jit_links.inc, JitGroup::Register), which
+// know neither. They stay off while the cores share, until the group links them too.
+static UserConfig EdenGroupConf(UserConfig conf) {
+    if (EdenShares(conf)) {
+        conf.host_call_return = false;
+        conf.compact_block_exits = false;
+    }
+    return conf;
+}
