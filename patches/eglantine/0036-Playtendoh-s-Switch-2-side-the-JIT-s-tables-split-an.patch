+// A table of blocks or link sites by location, split in 16 (by a mix of the location's hash): one
+// table took 62 MiB in one block in Ocarina of Time (the link sites of ~860,000 targets, 21 Nov), and
+// growing it asked for a 124 MiB block beside it, the pool at its end. Each part grows by itself.
+template <typename Value>
+class LocationTable {
+public:
+    static constexpr std::size_t Parts = 16;
+    [[nodiscard]] const Value* Find(IR::LocationDescriptor key) const {
+        const auto& part = parts[Index(key)];
+        const auto it = part.find(key);
+        return it == part.end() ? nullptr : &it->second;
+    }
+    std::pair<Value*, bool> TryEmplace(IR::LocationDescriptor key, const Value& value) {
+        const auto [it, inserted] = parts[Index(key)].try_emplace(key, value);
+        return {&it->second, inserted};
+    }
+    Value& operator[](IR::LocationDescriptor key) {
+        return parts[Index(key)][key];
+    }
+    std::size_t Erase(IR::LocationDescriptor key) {
+        return parts[Index(key)].erase(key);
+    }
+    void Clear() {
+        for (auto& part : parts)
+            part.clear();
+    }
+
+private:
+    static std::size_t Index(IR::LocationDescriptor key) {
+        const u64 hash = static_cast<u64>(std::hash<IR::LocationDescriptor>{}(key));
+        return static_cast<std::size_t>((hash * 0x9E3779B97F4A7C15ull) >> 60);
+    }
+    std::array<::Common::unordered_map<IR::LocationDescriptor, Value>, Parts> parts;
+};
