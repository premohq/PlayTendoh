@@ -168,7 +221,86 @@ void Spin(std::atomic_flag& flag) noexcept {
 struct PackedSlot {
     void* data = nullptr;
     std::uint32_t size = 0;
+    std::uint32_t sequence = 0; ///< Which packing this is (pack_sequence): the read-through's cache key
+    std::uint8_t codec = 0;     ///< CodecLz4 or CodecZstd: what packed it
 };
+// How slots are packed (Settings > Performance > Memory packing on the Switch 2 side, passed as
+// EDEN_CRAM_CODEC=zstd; else LZ4). LZ4 unpacks a 2 MiB slot fastest; zstd at level 1 packs tighter,
+// for memory that LZ4 barely shrinks (another PS5 port: Ocarina of Time's at 0.80-0.83 with LZ4,
+// 2.5:1 with zstd on what packs), and unpacks slower. Chosen when the service starts; each slot
+// keeps the codec that packed it. The contexts are made there too, on a workspace of their own:
+// the fault handler, where a slot unpacks, allocates nothing.
+enum : std::uint8_t { CodecLz4 = 0, CodecZstd = 1 };
+std::uint8_t pack_codec = CodecLz4;
+int pack_zstd_level = 1;
+ZSTD_CCtx* pack_cctx = nullptr; // the packer's: packing is one slot at a time (pack_scratch)
+constexpr unsigned UnpackContexts = 16;
+ZSTD_DCtx* unpack_dctx[UnpackContexts]{};
+std::atomic_flag unpack_dctx_busy[UnpackContexts]{};
+
+bool ChooseCodec() noexcept {
+    const char* value = std::getenv("EDEN_CRAM_CODEC");
+    if (value == nullptr || std::strcmp(value, "zstd") != 0) return false;
+    if (pack_cctx != nullptr) return true; // made for an earlier session of this process
+    if (&ZSTD_initStaticCCtx == nullptr || &ZSTD_initStaticDCtx == nullptr || &ZSTD_compressCCtx == nullptr ||
+        &ZSTD_decompressDCtx == nullptr || &ZSTD_estimateCCtxSize == nullptr || &ZSTD_estimateDCtxSize == nullptr ||
+        &ZSTD_compressBound == nullptr || &ZSTD_isError == nullptr)
+        return false;
+    if (const char* level = std::getenv("EDEN_CRAM_ZSTD_LEVEL"))
+        pack_zstd_level = std::clamp(static_cast<int>(std::strtol(level, nullptr, 10)), 1, 6);
+    const std::size_t compress_bytes = ZSTD_estimateCCtxSize(pack_zstd_level);
+    const std::size_t decompress_bytes = ZSTD_estimateDCtxSize();
+    void* const compress_space = std::malloc(compress_bytes);
+    void* const decompress_space = std::malloc(decompress_bytes * UnpackContexts);
+    if (compress_space == nullptr || decompress_space == nullptr) {
+        std::free(compress_space);
+        std::free(decompress_space);
+        return false;
+    }
+    ZSTD_CCtx* const compress = ZSTD_initStaticCCtx(compress_space, compress_bytes);
+    bool made = compress != nullptr;
