+// The graphics threads (GPU, GPUBack, ...; headless/performance.cpp names them here). They free what
+// the graphics caches hold, which a write waiting for a block depends on (WaitForBlock), and they
+// fault on the guest's memory too: Ocarina of Time unpacked 274 slots on GPUBack in one session. A
+// graphics thread that waited in its fault handler with the reserve emptied by the game's writes
+// left nothing to free that memory: the game's writes and its own all waited out their 6 s and the
+// session ended (19 Nov, Ocarina of Time after the fairy ocarina scene, every log quiet 7 s before).
+// So the reserve's last blocks are theirs (GraphicsFloor). 32 MiB of them were not enough: on 20 Nov
+// Ocarina of Time loading Castle Town took the floor 58 times in a session, then GPUBack waited in
+// its fault handler twice (a texture written back by the collector, a buffer's packed memory read
+// for an upload) and the session ended both times, the give-back that runs on it queued behind it.
+// A graphics thread that starts on the floor asks for that give-back at once (floor_touched).
+constexpr std::size_t GraphicsThreadSlots = 8;
+std::atomic<std::uintptr_t> graphics_threads[GraphicsThreadSlots];
+bool OnGraphicsThread() noexcept {
+    const auto self = (std::uintptr_t)pthread_self();
+    for (const auto& thread : graphics_threads)
+        if (thread.load(std::memory_order_relaxed) == self) return true;
+    return false;
+}
+// EDEN_CRAM_GRAPHICS_FLOOR_MIB, else 64 MiB; at most half the reserve.
+std::size_t GraphicsFloor() noexcept;
+// A graphics thread took a block below the floor (ReserveBlock): the keeper asks the graphics
