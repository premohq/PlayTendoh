+                // What the graphics caches can let go, now (performance.h, graphics_give_back): on
+                // the thread that draws, never waited for. The pass runs once for each ask, wherever
+                // it comes first.
+                if (eden_guest_read_through_copy && eden_guest_read_through_covers) {
+                    Common::GuestReadThrough::copy_fn.store(eden_guest_read_through_copy, std::memory_order_release);
+                    Common::GuestReadThrough::covers_packed_fn.store(
+                        +[](const void* src, std::size_t size) { return eden_guest_read_through_covers(src, size) != 0; },
+                        std::memory_order_release);
+                }
+                static std::atomic<unsigned> give_back_asks{0}, give_back_runs{0};
+                static std::atomic<void (*)(unsigned long long)> give_back_done{nullptr};
+                static void (*const run_give_back)() = [] {
+                    const unsigned asked = give_back_asks.load(std::memory_order_acquire);
+                    if (give_back_runs.exchange(asked, std::memory_order_acq_rel) == asked) return;
+                    auto* const running = reporting_system;
+                    auto* const done = give_back_done.load(std::memory_order_acquire);
+                    if (!running || done == nullptr) return;
+                    auto* const rasterizer = running->Renderer().ReadRasterizer();
+                    // The pass collects as after a refusal (costly images too); the frames after
+                    // it as before it, unless a refusal of their own came meanwhile. Set for the
+                    // second after each pass, the collectors made textures again and again
+                    // (Mario Kart World: slower, choppier).
+                    auto& refused_ns = Eden::Performance::graphics_memory_refused_ns;
+                    const long long before = refused_ns.load(std::memory_order_relaxed);
+                    Eden::Performance::NoteGraphicsMemoryRefused();
+                    long long noted = refused_ns.load(std::memory_order_relaxed);
+                    const unsigned long long bytes = rasterizer != nullptr ? rasterizer->ReleaseMemoryNow() : 0;
+                    refused_ns.compare_exchange_strong(noted, before, std::memory_order_relaxed);
+                    done(bytes);
+                };
+                Eden::Performance::graphics_give_back.store([](void (*done)(unsigned long long)) -> bool {
+                    auto* const running = reporting_system;
+                    if (!running || !running->IsPoweredOn()) return false;
+                    give_back_done.store(done, std::memory_order_release);
+                    give_back_asks.fetch_add(1, std::memory_order_acq_rel);
+                    // While the GPU's back thread works through its entries, between two of them:
+                    // queued after the work before it, the pass waited behind a full queue until a
+                    // write of the game's memory found no block (Ocarina of Time loading Castle
+                    // Town, 20 Nov: no pass in a whole session, this thread waiting in the queue).
+                    auto& split = VideoCommon::GpuSplit::Get();
+                    if (split.Active() && split.BackWorking()) {
+                        split.RequestBetweenEntries(run_give_back);
+                        if (split.BackWorking()) return true;
+                    }
+                    // A quiet back (it may stay so) or no split: after the work queued before it.
+                    running->GPU().RunInOrder([] { run_give_back(); });
+                    return true;
+                });
