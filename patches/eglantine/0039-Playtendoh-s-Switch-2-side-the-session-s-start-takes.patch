+namespace {
+// An allocation the heap refused waits for memory before the session ends: operator new's handler
+// sleeps 20 ms and returns, so the allocation is tried again, for up to EDEN_NEW_WAIT_MS (0 to
+// 10,000; else 1,000), with the heap's empty spaces given back at its start and every 500 ms. The
+// graphics caches give memory back between the GPU back thread's entries now, so a short wait can
+// end with memory where the refusal ended the session (as another PS5 port's operator new does).
+// Not on the threads that build pipelines (Vulkan*, VkShader*: a build that waited got nothing), not
+// for a request over 1 GiB, and after a wait that ran out the thread's refusals throw at once for
+// 30 s. The GPU threads (GPU*) wait too, up to EDEN_NEW_WAIT_GPU_MS (0 to 10,000; else 2,000):
+// GPUBack's refused heap growth ended Ocarina of Time's longest session (22 Nov 03:51, 37 min).
+// While a thread waits, the shader cache's programs read at boot go (once), cold game memory is
+// packed every 100 ms (eden_memory_recover_heap: no driver step, nothing allocated), and the heap's
+// empty spaces go back every 500 ms.
+extern "C" std::size_t eden_memory_recover_heap(std::size_t bytes) noexcept __attribute__((weak));
+extern "C" std::size_t eden_shader_programs_drop(std::size_t* count) __attribute__((weak));
+bool NewHandlerWaits(std::size_t bytes) {
+    static const long long limit_ns = [] {
+        const char* value = std::getenv("EDEN_NEW_WAIT_MS");
+        const long long ms = value != nullptr ? std::clamp<long long>(std::strtoll(value, nullptr, 10), 0, 10000) : 1000;
+        return ms * 1'000'000;
+    }();
+    static const long long gpu_limit_ns = [] {
+        const char* value = std::getenv("EDEN_NEW_WAIT_GPU_MS");
+        const long long ms = value != nullptr ? std::clamp<long long>(std::strtoll(value, nullptr, 10), 0, 10000) : 2000;
+        return ms * 1'000'000;
+    }();
+    if (bytes > (std::size_t{1} << 30)) return false;
+    thread_local int may_wait = -1; // 0 no, 1 yes, 2 a GPU thread
+    if (may_wait < 0) {
+        char name[32]{};
+        pthread_getname_np(pthread_self(), name, sizeof(name));
+        may_wait = std::strncmp(name, "Vulkan", 6) == 0 || std::strncmp(name, "VkShader", 8) == 0 ? 0
+                   : std::strncmp(name, "GPU", 3) == 0                                          ? 2
+                                                                                                  : 1;
+    }
+    const long long budget_ns = may_wait == 2 ? gpu_limit_ns : may_wait == 1 ? limit_ns : 0;
+    if (budget_ns == 0) return false;
+    thread_local long long started_ns = 0, last_ns = 0, cooldown_ns = 0;
+    const long long now = Eden::Performance::GraphicsMemoryClockNs();
+    if (now < cooldown_ns) return false;
+    if (now - last_ns > 1'000'000'000) {
+        started_ns = now; // a new wait
+        static std::atomic<unsigned> logged{0};
+        if (logged.fetch_add(1, std::memory_order_relaxed) < 32) {
+            char name[32]{};
+            pthread_getname_np(pthread_self(), name, sizeof(name));
+            std::fprintf(stderr, "EDEN_NEW_WAIT %zu bytes refused on %s: waiting for memory\n", bytes, name);
+        }
+    }
+    last_ns = now;
+    if (now - started_ns >= budget_ns) {
+        cooldown_ns = now + 30'000'000'000LL;
+        return false;
+    }
+    static std::atomic<bool> programs_dropped{false};
+    if (eden_shader_programs_drop != nullptr && !programs_dropped.exchange(true, std::memory_order_relaxed)) {
+        std::size_t programs = 0;
+        const std::size_t freed = eden_shader_programs_drop(&programs);
+        if (programs != 0)
+            std::fprintf(stderr, "EDEN_SHADER_PROGRAMS let go %zu programs read at boot (%zu MiB): an allocation waits\n",
+                         programs, freed >> 20);
+    }
+    static std::atomic<long long> recovered_ns{0};
+    if (eden_memory_recover_heap != nullptr && now - recovered_ns.load(std::memory_order_relaxed) >= 100'000'000) {
+        recovered_ns.store(now, std::memory_order_relaxed);
+        (void)eden_memory_recover_heap(bytes + (std::size_t{8} << 20));
+    }
+    static std::atomic<long long> trimmed_ns{0};
+    if (now - trimmed_ns.load(std::memory_order_relaxed) >= 500'000'000) {
+        trimmed_ns.store(now, std::memory_order_relaxed);
+        Eden::Performance::TrimHeap("an allocation waits for memory");
+    }
+    const timespec pause{0, 20'000'000};
+    nanosleep(&pause, nullptr);
+    return true;
+}
