+// Where the heap's free memory sits for a request (headless/heap_arenas.inc), and what its last
+// growth got from the pool (src/memory_pages.cpp): a measure for the heap's next change.
+extern "C" void eden_heap_space_detail(char*, size_t, size_t) __attribute__((weak));
