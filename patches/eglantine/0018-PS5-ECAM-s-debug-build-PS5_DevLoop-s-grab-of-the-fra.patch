diff --git a/tools/eglantine-patches/0078-devloop-grab.patch b/tools/eglantine-patches/0078-devloop-grab.patch
new file mode 100644
index 0000000..9e7d1ab
--- /dev/null
+++ b/tools/eglantine-patches/0078-devloop-grab.patch
@@ -0,0 +1,107 @@
+diff --git a/src/video_core/renderer_vulkan/vk_swapchain.cpp b/src/video_core/renderer_vulkan/vk_swapchain.cpp
+index a0ed5a4..e616549 100644
+--- a/src/video_core/renderer_vulkan/vk_swapchain.cpp
++++ b/src/video_core/renderer_vulkan/vk_swapchain.cpp
+@@ -18,6 +18,11 @@
+ #include "common/settings_enums.h"
+ #include "video_core/renderer_vulkan/vk_scheduler.h"
+ #include "video_core/renderer_vulkan/vk_swapchain.h"
++#ifdef PLAYTENDOH_DEBUG
++// PS5-ECAM: a debug build's PS5_DevLoop grab of the frame shown (its port/devloop/grab.h, app/paths.h)
++#include "app/paths.h"
++#include "devloop/grab.h"
++#endif
+ #include "video_core/vulkan_common/vk_enum_string_helper.h"
+ #include "video_core/vulkan_common/vulkan_device.h"
+ #include "video_core/vulkan_common/vulkan_wrapper.h"
+@@ -25,6 +30,16 @@
+ 
+ namespace Vulkan {
+ 
++#ifdef PLAYTENDOH_DEBUG
++namespace {
++devloop::Grab devloop_grab;
++VkQueue devloop_queue{};                // the present queue, as the grab submits to it
++VkSwapchainKHR devloop_swapchain{};     // the swapchain the grab was last given
++VkImageUsageFlags devloop_usage{};      // what that swapchain was made for
++bool devloop_ready{};
++} // namespace
++#endif
++
+ namespace {
+ 
+ VkSurfaceFormatKHR ChooseSwapSurfaceFormat(vk::Span<VkSurfaceFormatKHR> formats) {
+@@ -130,7 +145,14 @@ Swapchain::Swapchain(
+     Create(surface, width_, height_);
+ }
+ 
+-Swapchain::~Swapchain() = default;
++Swapchain::~Swapchain() {
++#ifdef PLAYTENDOH_DEBUG
++    // what the grab made, while the device is still there (the renderer's swapchain goes before it)
++    devloop_grab.Destroy();
++    devloop_ready = false;
++    devloop_swapchain = VK_NULL_HANDLE;
++#endif
++}
+ 
+ void Swapchain::Create(
+     VkSurfaceKHR_T* surface_,
+@@ -227,7 +249,23 @@ void Swapchain::Present(VkSemaphore render_semaphore) {
+         .pResults = nullptr,
+     };
+     std::scoped_lock lock{scheduler.submit_mutex};
++#ifdef PLAYTENDOH_DEBUG
++    // PS5-ECAM: a debug build answers PS5_DevLoop's grab with the frame as it is shown
++    VkResult presented;
++    if (devloop_ready) {
++        if (devloop_swapchain != *swapchain) {
++            devloop_swapchain = *swapchain;
++            devloop_grab.SetSwapchain(devloop_swapchain, images, surface_format.format, extent, devloop_usage);
++        }
++        presented = devloop_grab.QueuePresent(devloop_queue, present_info,
++                                              device.GetDispatchLoader().vkQueuePresentKHR);
++    } else {
++        presented = present_queue.Present(present_info);
++    }
++    switch (const VkResult result = presented) {
++#else
+     switch (const VkResult result = present_queue.Present(present_info)) {
++#endif
+     case VK_SUCCESS:
+         break;
+     case VK_SUBOPTIMAL_KHR:
+@@ -287,7 +325,13 @@ void Swapchain::CreateSwapchain(const VkSurfaceCapabilitiesKHR& capabilities) {
+         .imageColorSpace = surface_format.colorSpace,
+         .imageExtent = {},
+         .imageArrayLayers = 1,
++#ifdef PLAYTENDOH_DEBUG
++        // a debug build copies the frame shown out when PS5_DevLoop asks, where the surface lets it
++        .imageUsage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
++                      (capabilities.supportedUsageFlags & VK_IMAGE_USAGE_TRANSFER_SRC_BIT),
++#else
+         .imageUsage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
++#endif
+         .imageSharingMode = VK_SHARING_MODE_EXCLUSIVE,
+         .queueFamilyIndexCount = 0,
+         .pQueueFamilyIndices = nullptr,
+@@ -340,6 +384,19 @@ void Swapchain::CreateSwapchain(const VkSurfaceCapabilitiesKHR& capabilities) {
+     extent = swapchain_ci.imageExtent;
+ 
+     images = swapchain.GetImages();
++#ifdef PLAYTENDOH_DEBUG
++    if (!devloop_ready) {
++        const auto& dld = device.GetDispatchLoader();
++        VkPhysicalDeviceMemoryProperties memory{};
++        dld.vkGetPhysicalDeviceMemoryProperties(device.GetPhysical(), &memory);
++        dld.vkGetDeviceQueue(*device.GetLogical(), device.GetPresentFamily(), 0, &devloop_queue);
++        devloop_ready = devloop_grab.Init(*device.GetLogical(), dld.vkGetDeviceProcAddr, memory,
++                                          device.GetPresentFamily(), ps5paths::AppDir(),
++                                          [](const std::string& line) { LOG_INFO(Render_Vulkan, "{}", line); });
++    }
++    devloop_swapchain = VK_NULL_HANDLE; // given to the grab again at the next present
++    devloop_usage = swapchain_ci.imageUsage;
++#endif
+     image_count = static_cast<u32>(images.size());
+ #ifdef __ANDROID__
+     // Android is already ordered the same as Switch.
