From: Phononenom <64574232+Phononenom@users.noreply.github.com>
Date: Tue, 17 Nov 2026 05:49:10 -0600
Subject: [PATCH] PS5-ECAM's debug build: PS5_DevLoop's grab of the frame
 shown, OpenGL and Vulkan

In PS5-ECAM's debug build (PLAYTENDOH_DEBUG, passed to the configure) the Switch 2 side answers
PS5_DevLoop's grab with the frame as it is shown, with PS5-ECAM's port/devloop/grab.h: OpenGL's default
framebuffer read back before each swap (the game's and the loading screen's, headless/graphics.cpp), and
Vulkan's swapchain image at its present (tools/eglantine-patches/0078-devloop-grab.patch, carried into
the derived vulkan_swapchain.cpp). A release build is as before.
---
 headless/graphics.cpp                         |  46 ++++++++
 headless/inject.cmake                         |   8 ++
 tools/build-headless-native.sh                |   1 +
 .../eglantine-patches/0078-devloop-grab.patch | 107 ++++++++++++++++++
 4 files changed, 162 insertions(+)
 create mode 100644 tools/eglantine-patches/0078-devloop-grab.patch

diff --git a/headless/graphics.cpp b/headless/graphics.cpp
index 25bdece..34eea24 100644
--- a/headless/graphics.cpp
+++ b/headless/graphics.cpp
@@ -25,6 +25,12 @@
 #include "diagnostics.h"
 #include "display_refresh.h"
 #include "graphics.h"
+#ifdef PLAYTENDOH_DEBUG
+// PS5-ECAM: a debug build's PS5_DevLoop grab of the OpenGL frame shown (its port/devloop/grab.h)
+#define DEVLOOP_NO_VULKAN
+#include "app/paths.h"
+#include "devloop/grab.h"
+#endif
 #include "common/scope_exit.h"
 #include "core/core.h"
 #include "core/frontend/graphics_context.h"
@@ -44,6 +50,40 @@ extern "C" int sceSystemServiceHideSplashScreen(void);
 #endif
 
 namespace Eden {
+
+#ifdef PLAYTENDOH_DEBUG
+namespace {
+// Before a frame is shown: when PS5_DevLoop asks, the default framebuffer read back as it is about to be
+// shown (the game with the HUD, the in-game menu and the loading screen over it) and written for the
+// payload. The GL state it touches is put back.
+void DevLoopGrab(EGLDisplay display, EGLSurface surface) {
+    static uint64_t calls = 0;
+    static const std::string folder = ps5paths::AppDir();
+    if (folder.empty() || !devloop::Asked(folder, calls)) return;
+    EGLint width = 0, height = 0;
+    eglQuerySurface(display, surface, EGL_WIDTH, &width);
+    eglQuerySurface(display, surface, EGL_HEIGHT, &height);
+    if (width <= 0 || height <= 0) return;
+    GLint read_framebuffer = 0, pack_buffer = 0, pack_alignment = 4, pack_row_length = 0;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_framebuffer);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buffer);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &pack_alignment);
+    glGetIntegerv(GL_PACK_ROW_LENGTH, &pack_row_length);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    std::vector<uint8_t> rgba(static_cast<size_t>(width) * height * 4);
+    glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, rgba.data());
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, read_framebuffer);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, pack_buffer);
+    glPixelStorei(GL_PACK_ALIGNMENT, pack_alignment);
+    glPixelStorei(GL_PACK_ROW_LENGTH, pack_row_length);
+    devloop::SaveRgba(folder, rgba.data(), static_cast<uint32_t>(width), static_cast<uint32_t>(height), true,
+                      [](const std::string& line) { std::printf("%s\n", line.c_str()); });
+}
+} // namespace
+#endif
 #ifdef EDEN_PS5_VULKAN
 void PresentVulkanLoading(VideoCore::RendererBase& renderer);
 #endif
@@ -389,6 +429,9 @@ public:
         const auto text = FormatHudText(clock, speed_percent, "OGL", machine, RoomPingMilliseconds(),
                                         hud_fields.load(std::memory_order_relaxed));
         if (hud_enabled.load(std::memory_order_relaxed)) DrawHud(text.data(), false);
+#ifdef PLAYTENDOH_DEBUG
+        DevLoopGrab(display, surface);
+#endif
         Check(eglSwapBuffers(display, surface), "eglSwapBuffers");
     }
     void PresentLoading() {
@@ -401,6 +444,9 @@ public:
             for (unsigned i = 0; i < dots; ++i) text[7 + i] = '.';
             DrawHud(text, true);
         }
+#ifdef PLAYTENDOH_DEBUG
+        DevLoopGrab(display, surface);
+#endif
         Check(eglSwapBuffers(display, surface), "loading swap");
         if (loading_frames++ < 4) std::printf("EDEN_LOADING frame=%u scene=%d\n", loading_frames, !loading_failed);
     }
diff --git a/headless/inject.cmake b/headless/inject.cmake
index 04894cc..268bb90 100644
--- a/headless/inject.cmake
+++ b/headless/inject.cmake
@@ -21,3 +21,11 @@ if(PS5_NATIVE)
                         "-ffile-prefix-map=${CMAKE_BINARY_DIR}/=build/"
                         "-ffile-prefix-map=${EDEN_PORT_ROOT}/=")
 endif()
+# PS5-ECAM's debug build (its make DEBUG=1): PS5_DevLoop's grab of the frame shown, at OpenGL's swap
+# (graphics.cpp) and Vulkan's present (tools/eglantine-patches/0078-devloop-grab.patch, carried into the
+# derived vulkan_swapchain.cpp), with PS5-ECAM's port/devloop/grab.h and app/paths.h from the port/
+# folder PS5ECAM_PORT names. Before any target exists.
+if(PLAYTENDOH_DEBUG AND EXISTS "$ENV{PS5ECAM_PORT}/devloop/grab.h")
+    add_compile_definitions(PLAYTENDOH_DEBUG=1)
+    include_directories(AFTER "$ENV{PS5ECAM_PORT}")
+endif()
