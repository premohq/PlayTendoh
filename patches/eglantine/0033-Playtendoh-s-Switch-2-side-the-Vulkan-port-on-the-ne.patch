+    "    impl->stack.Allocate(::Eden::FiberStack::StackBytes());\n    impl->stack_limit = impl->stack.data();"
     fiber_source "${fiber_source}")
+# Lichii allocates the stack itself, uninitialized, on the heap (its pages get memory as they are
+# used): here it comes from the flexible pool all the same.
+string(REPLACE "    std::unique_ptr<u8[]> stack;" "    ::Eden::FiberStack stack;" fiber_source "${fiber_source}")
+string(REPLACE "    impl->stack.reset(new u8[DEFAULT_STACK_SIZE]);\n    impl->stack_limit = impl->stack.get();"
