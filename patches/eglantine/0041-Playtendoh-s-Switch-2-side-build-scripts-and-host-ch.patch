diff --git a/tools/check-extracted-content.py b/tools/check-extracted-content.py
index 67b28c3..a98bb39 100644
--- a/tools/check-extracted-content.py
+++ b/tools/check-extracted-content.py
@@ -7,6 +7,11 @@ import tempfile
 
 root = Path(__file__).resolve().parents[1]
 loader = (root / 'Eglantine/src/core/loader/deconstructed_rom_directory.cpp').read_text()
+if 'std::vector<FileSys::VirtualDir> ExtractedLayers(' not in loader:
+    # Core patch 0001 (versioned content folders) is pending on this core (tools/eglantine-patches-pending):
+    # the loader takes plain extracted folders as the core does.
