 }
 
+/* ---- free runs inside the spaces, given back while a write of the game's memory waits ----
+ *
+ * A space gives its memory back only once it holds no block (eden_heap_trim), and in a long
+ * session none does: Ocarina of Time's heap held 1.92 GB with 308-324 MiB of it free across 58
+ * spaces (21 Nov) while a write of the game's memory waited 10 s for a free 2 MiB block and the
+ * session ended. While such a write waits, eden_heap_balloon_inflate takes the runs of 4 MiB or
+ * more still free in the spaces as blocks of its own and gives the whole 2 MiB pages inside them
+ * back to the system (eden_heap_page_out). A piece's memory is 2 MiB-aligned blocks, so each such
+ * page is a free 2 MiB block of the pool. The blocks stay taken, counted in their space like any
+ * other (eden_heap_trim leaves the space), until eden_heap_balloon_deflate gives their pages memory
+ * again and frees them: before the heap would grow, and once the pool has had room for a while.
+ * Neither waits for the other: whichever finds the flag set does nothing this time. */
+#define EDEN_HEAP_BALLOONS 1024u
+static struct {
+  void *block;   /* the space's block over the run */
+  uintptr_t out; /* its pages given back: [out, out + size) */
+  size_t size;
+} eden_heap_balloons[EDEN_HEAP_BALLOONS];
+static unsigned eden_heap_balloon_count; /* under eden_heap_balloon_lock */
+static atomic_flag eden_heap_balloon_lock = ATOMIC_FLAG_INIT;
+static atomic_size_t eden_heap_balloon_bytes; /* given back now */
+
+size_t eden_heap_balloon_held(void) {
+  return atomic_load_explicit(&eden_heap_balloon_bytes, memory_order_relaxed);
+}
+
+/* Whether [begin, end) lies in the pieces of one slot's space. */
+static int eden_heap_in_slot(uintptr_t begin, uintptr_t end, unsigned slot) {
+  if (!eden_heap_in_range((const void *)begin) || !eden_heap_in_range((const void *)(end - 1)))
+    return 0;
+  const uintptr_t base = (uintptr_t)ps5_heap_base;
+  return atomic_load_explicit(&eden_heap_piece_slot[(begin - base) >> EDEN_HEAP_PIECE_SHIFT], memory_order_acquire) == slot &&
+         atomic_load_explicit(&eden_heap_piece_slot[(end - 1 - base) >> EDEN_HEAP_PIECE_SHIFT], memory_order_acquire) == slot;
+}
+
+size_t eden_heap_balloon_inflate(size_t want) {
+  if (atomic_load_explicit(&ps5_heap_state, memory_order_acquire) != 2 || !eden_heap_grows)
+    return 0;
+  if (atomic_flag_test_and_set_explicit(&eden_heap_balloon_lock, memory_order_acquire))
+    return 0;
+  static const size_t sizes[] = {(size_t)16 << 20, (size_t)12 << 20, (size_t)8 << 20, (size_t)6 << 20,
+                                 (size_t)4 << 20};
+  const uintptr_t large_page = (uintptr_t)2 << 20;
+  size_t given = 0;
+  const unsigned count = atomic_load_explicit(&eden_heap_space_count, memory_order_acquire);
+  for (unsigned slot = 0; slot < count && slot < EDEN_HEAP_PIECES && given < want; ++slot) {
+    if (atomic_load_explicit(&eden_heap_spaces[slot], memory_order_acquire) == NULL)
+      continue;
+    unsigned s = 0;
+    while (s < sizeof(sizes) / sizeof(sizes[0]) && given < want && eden_heap_balloon_count < EDEN_HEAP_BALLOONS) {
+      void *block = eden_heap_space_use(slot, EDEN_HEAP_MALLOC, sizes[s], 0);
+      if (block == NULL) {
+        ++s;
+        continue;
+      }
+      const uintptr_t begin = (uintptr_t)block, end = begin + sceLibcMspaceMallocUsableSize(block);
+      const uintptr_t out = (begin + large_page - 1) & ~(large_page - 1), last = end & ~(large_page - 1);
+      size_t size = 0;
+      if (last > out && eden_heap_in_slot(begin, end, slot)) {
+        if (eden_heap_page_out((void *)out, last - out) == 1) {
+          size = last - out;
+        } else {
+          /* Over more than one of the piece's blocks: a page at a time, as far as it goes. */
+          while (out + size < last && eden_heap_page_out((void *)(out + size), large_page) == 1)
+            size += large_page;
+        }
+      }
+      if (size == 0) {
+        eden_heap_space_free(block);
+        ++s;
+        continue;
+      }
+      eden_heap_balloons[eden_heap_balloon_count].block = block;
+      eden_heap_balloons[eden_heap_balloon_count].out = out;
+      eden_heap_balloons[eden_heap_balloon_count].size = size;
+      ++eden_heap_balloon_count;
+      given += size;
+    }
+  }
+  atomic_fetch_add_explicit(&eden_heap_balloon_bytes, given, memory_order_relaxed);
+  atomic_flag_clear_explicit(&eden_heap_balloon_lock, memory_order_release);
+  return given;
+}
+
+/* `want` bytes of the runs back in the spaces (0: all of them), the last taken first. A page the
+ * pool has no memory for now stays given back, and so does its block. */
+size_t eden_heap_balloon_deflate(size_t want) {
+  if (atomic_load_explicit(&eden_heap_balloon_bytes, memory_order_relaxed) == 0)
+    return 0;
+  if (atomic_flag_test_and_set_explicit(&eden_heap_balloon_lock, memory_order_acquire))
+    return 0;
+  const size_t large_page = (size_t)2 << 20, part = (size_t)512 << 10;
+  size_t back = 0;
+  while (eden_heap_balloon_count != 0 && (want == 0 || back < want)) {
+    void *block = eden_heap_balloons[eden_heap_balloon_count - 1].block;
+    const uintptr_t out = eden_heap_balloons[eden_heap_balloon_count - 1].out;
+    size_t size = eden_heap_balloons[eden_heap_balloon_count - 1].size;
+    while (size != 0) {
+      /* 2 MiB at once, else in 512 KiB parts (the pool may have no 2 MiB in one piece). */
+      /* Without the recovery (eden_heap_page_in_quiet): this runs inside the heap, maybe under its
+       * arena-creation lock, and the recovery's driver compaction allocates from the heap. */
+      const size_t step = size >= large_page && size % large_page == 0 &&
+                                  eden_heap_page_in_quiet((void *)(out + size - large_page), large_page) == 1
+                              ? large_page
+                          : eden_heap_page_in_quiet((void *)(out + size - part), part) == 1 ? part
+                                                                                             : 0;
+      if (step == 0)
+        break;
+      size -= step;
+      back += step;
+      atomic_fetch_sub_explicit(&eden_heap_balloon_bytes, step, memory_order_relaxed);
+    }
+    eden_heap_balloons[eden_heap_balloon_count - 1].size = size;
+    if (size != 0)
+      break;
+    eden_heap_space_free(block);
+    --eden_heap_balloon_count;
+  }
+  atomic_flag_clear_explicit(&eden_heap_balloon_lock, memory_order_release);
+  return back;
+}
+
