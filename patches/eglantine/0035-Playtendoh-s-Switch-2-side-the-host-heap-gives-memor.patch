+/* Where the heap's memory that no block uses sits, for a request of `request` bytes (a measure for
+ * the heap allocator's next change; on an allocation failure and in the memory report): its spaces
+ * outside the arenas (memory held and blocks' bytes; the largest free in one space, and how many
+ * spaces have at least `request` free, free not being one hole), and its arenas. A snapshot, read
+ * without locks; no allocation (it may run in the new handler). */
+void eden_heap_space_detail(char *line, size_t size, size_t request) {
+  const unsigned count = atomic_load_explicit(&eden_heap_space_count, memory_order_relaxed);
+  size_t held = 0, live = 0, largest = 0;
+  unsigned spaces = 0, room = 0;
+  for (unsigned slot = 0; slot < count && slot < EDEN_HEAP_PIECES; ++slot) {
+    if (atomic_load_explicit(&eden_heap_spaces[slot], memory_order_relaxed) == NULL)
+      continue;
+    const size_t space_held = slot == 0 && eden_heap_space_span[slot] == 0
+                                  ? EDEN_HEAP_PIECE_SIZE
+                                  : (size_t)eden_heap_space_span[slot] << EDEN_HEAP_PIECE_SHIFT;
+    const long bytes = atomic_load_explicit(&eden_heap_space_bytes[slot], memory_order_relaxed);
+    const size_t space_live = bytes > 0 ? (size_t)bytes : 0;
+    const size_t space_free = space_held > space_live ? space_held - space_live : 0;
+    ++spaces;
+    held += space_held;
+    live += space_live;
+    largest = space_free > largest ? space_free : largest;
+    room += space_free >= request;
+  }
+  const unsigned arena_count = atomic_load_explicit(&eden_heap_arena_count, memory_order_relaxed);
+  long arena_live = 0;
+  for (unsigned i = 0; i < arena_count && i < EDEN_HEAP_MAX_ARENAS; ++i)
+    if (eden_heap_arena_list[i] != NULL)
+      arena_live += atomic_load_explicit(&eden_heap_slot_live[eden_heap_slot(eden_heap_arena_list[i])],
+                                         memory_order_relaxed);
+  const size_t arena_held = (size_t)arena_count * EDEN_HEAP_ARENA_SIZE;
+  const size_t arena_used = arena_live > 0 ? (size_t)arena_live : 0;
+  snprintf(line, size,
+           "EDEN_HEAP_SPACES for %zu KiB: %u spaces hold %zu MiB, their blocks %zu MiB (the arenas' own "
+           "%zu MiB among them), free %zu MiB, the most in one %zu MiB, %u with that much free; %u "
+           "arenas %zu MiB, %zu MiB free\n",
+           request >> 10, spaces, held >> 20, live >> 20, arena_held >> 20,
+           held > live ? (held - live) >> 20 : 0, largest >> 20, room, arena_count, arena_held >> 20,
+           arena_held > arena_used ? (arena_held - arena_used) >> 20 : 0);
+}
