+// Anonymous CPU mappings use the console's flexible pool, leaving direct memory for guest RAM
+// and GPU resources. Guard pages surround the usable stack. Exhaustion falls back to the existing
+// heap domain.
+//
+// Size: 512 KiB (StackBytes), the size upstream gives its other PlayStation target (fiber.cpp,
+// __OPENORBIS__), not 2 MiB: a session makes 128 or more and the flexible pool is a few hundred
+// MiB, which the app's own image shares; its free part can become direct memory (param.json).
+// Each stack is painted when made, and the deepest any was used is measured from the paint
+// (DeepestUse, in stderr.log every 10 s), so the size is checked on the console, not assumed. An
+// overflow lands in the guard page below it: a crash at a known address, not in a neighbour.
 class FiberStack {
 public:
     FiberStack() = default;
     FiberStack(const FiberStack&) = delete;
     FiberStack& operator=(const FiberStack&) = delete;
     ~FiberStack() {
+        if (base) {
+            NoteUse(Used());
+            std::lock_guard lock{live_mutex};
+            std::erase(live, this);
+        }
         if (mapping) {
             if (munmap(mapping, bytes + 2 * GuardBytes)) std::abort();
             flexible_bytes.fetch_sub(bytes, std::memory_order_relaxed);
@@ -51,6 +66,14 @@ public:
             std::memcpy(base + bytes, Canary.data(), CanaryBytes);
             fallback_bytes.fetch_add(bytes, std::memory_order_relaxed);
         }
+        auto* const words = reinterpret_cast<unsigned long long*>(base);
+        for (std::size_t i = 0; i < bytes / sizeof(unsigned long long); ++i) words[i] = Paint;
+        try {
+            std::lock_guard lock{live_mutex};
+            live.push_back(this);
+        } catch (...) {
+            // Not measured while live; still measured when it goes.
+        }
         const auto count = allocations.fetch_add(1, std::memory_order_relaxed) + 1;
         if ((count & (count - 1)) == 0) {
             std::fprintf(stderr, "EDEN_FIBER_STACK allocations=%llu flexible=%llu fallback=%llu stack_bytes=%zu\n",
@@ -59,9 +82,48 @@ public:
     }
     unsigned char* data() noexcept { return base; }
     std::size_t size() const noexcept { return bytes; }
+    // EDEN_FIBER_STACK_SIZE_KIB (env.txt), 256 to 2048 KiB in whole guard pages, else 512 KiB.
+    // Read at the first fiber: every stack of a run has one size.
+    static std::size_t StackBytes() noexcept {
+        static const std::size_t value = [] {
+            const char* asked = std::getenv("EDEN_FIBER_STACK_SIZE_KIB");
+            const std::size_t kib =
+                std::clamp<std::size_t>(asked ? std::strtoull(asked, nullptr, 10) : 512, 256, 2048);
+            return std::max<std::size_t>(GuardBytes, kib * 1024 / GuardBytes * GuardBytes);
+        }();
+        return value;
+    }
+    // The deepest any stack was used so far, live ones included (bytes, a 4 KiB page at a time),
+    // and how many are live.
+    static std::size_t DeepestUse(std::size_t* live_count = nullptr) noexcept {
+        std::lock_guard lock{live_mutex};
+        for (const FiberStack* stack : live) NoteUse(stack->Used());
+        if (live_count) *live_count = live.size();
+        return deepest.load(std::memory_order_relaxed);
+    }
     inline static std::atomic<unsigned long long> flexible_bytes{}, fallback_bytes{}, allocations{};
     static constexpr std::size_t GuardBytes = 16384;
 private:
+    static constexpr unsigned long long Paint = 0x5f3a91c64be27d08ULL;
+    static constexpr std::size_t ProbePage = 4096;
+    // The stack grows down from base + bytes: the first page from the bottom whose sampled words
+    // are not all paint is the deepest one used.
+    std::size_t Used() const noexcept {
+        for (std::size_t offset = 0; offset < bytes; offset += ProbePage) {
+            const auto* words = reinterpret_cast<const volatile unsigned long long*>(base + offset);
+            for (std::size_t i = 0; i < ProbePage / sizeof(unsigned long long); i += 64)
+                if (words[i] != Paint) return bytes - offset;
+        }
+        return 0;
+    }
+    static void NoteUse(std::size_t used) noexcept {
+        std::size_t seen = deepest.load(std::memory_order_relaxed);
+        while (used > seen && !deepest.compare_exchange_weak(seen, used, std::memory_order_relaxed)) {
+        }
+    }
+    inline static std::mutex live_mutex;
+    inline static std::vector<FiberStack*> live;
+    inline static std::atomic<std::size_t> deepest{};
     inline static constexpr std::array<unsigned long long, 2> Canary{
         0x8d569a12e3c047bfULL, 0x729db60f24e1ac83ULL};
     static constexpr std::size_t CanaryBytes = sizeof(Canary);
