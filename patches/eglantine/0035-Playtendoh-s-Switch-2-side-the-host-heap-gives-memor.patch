   const size_t bytes = kind == EDEN_HEAP_MALLOC ? a : kind == EDEN_HEAP_CALLOC ? a * b : a + b;
   for (;;) {
@@ -848,7 +1019,12 @@ static void *eden_heap_main(int kind, size_t a, size_t b) {
         return address;
       }
     }
-    if (bytes == 0 || !eden_heap_grow(bytes, generation))
+    if (bytes == 0)
+      return NULL;
+    /* Runs given back while a write waited come back before the heap takes a new piece. */
+    if (eden_heap_balloon_deflate(bytes + ((size_t)1 << 20)) != 0)
+      continue;
+    if (!eden_heap_grow(bytes, generation))
       return NULL;
   }
 }
@@ -1423,6 +1599,12 @@ static void *eden_realloc_inner(void *address, size_t size) {
     if (in_arena) {
       eden_heap_slot_count(result != NULL ? result : address, 1);
       eden_heap_arena_leave(address);
+    } else if (result != NULL) {
+      /* In its space still (the same mspace): its bytes there change by the difference. */
+      const uintptr_t piece = ((uintptr_t)address - (uintptr_t)ps5_heap_base) >> EDEN_HEAP_PIECE_SHIFT;
+      const unsigned slot = atomic_load_explicit(&eden_heap_piece_slot[piece], memory_order_acquire);
+      atomic_fetch_add_explicit(&eden_heap_space_bytes[slot],
+                                (long)sceLibcMspaceMallocUsableSize(result) - (long)before, memory_order_relaxed);
     }
     if (result) {
       eden_heap_account((long)sceLibcMspaceMallocUsableSize(result) - (long)before, 0);
diff --git a/headless/heap_pages.cpp b/headless/heap_pages.cpp
index ed1612b..c86ff30 100644
--- a/headless/heap_pages.cpp
+++ b/headless/heap_pages.cpp
@@ -52,6 +52,19 @@ extern "C" int eden_heap_page_out(void* address, std::size_t size) {
 extern "C" int eden_heap_page_in(void* address, std::size_t size) {
