diff --git a/tools/check-radv-compact.py b/tools/check-radv-compact.py
new file mode 100644
index 0000000..43a30a9
--- /dev/null
+++ b/tools/check-radv-compact.py
@@ -0,0 +1,532 @@
+#!/usr/bin/env python3
+"""Builds the driver memory compaction's planner (tools/radv-compact-plan.inc) on the host and checks
+its plans: as many pieces emptied as their units can fit elsewhere (or the limit), every unit in use of
+an emptied piece moved once, each into a free unit of a piece that stays, no unit taken twice."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+plan = (root / 'tools/radv-compact-plan.inc').read_text()
+code = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+struct radv_ps5_memory;
+''' + plan + r'''
+#define MAX_PIECES 600
+static struct radv_ps5_compact_move moves[MAX_PIECES * 31];
+
+static uint32_t
+run(struct radv_ps5_compact_piece *pieces, uint32_t count, uint32_t limit, uint32_t *moved)
+{
+   uint32_t order[MAX_PIECES];
+   radv_ps5_compact_order(pieces, count, order);
+   for (uint32_t i = 1; i < count; ++i)
+      assert(__builtin_popcount(pieces[order[i - 1]].used) >= __builtin_popcount(pieces[order[i]].used));
+   return radv_ps5_compact_plan(pieces, order, count, limit, moves, moved);
+}
+
+static void
+check(const struct radv_ps5_compact_piece *pieces, uint32_t count, uint32_t limit, uint32_t emptied, uint32_t moved)
+{
+   uint64_t in_use = 0;
+   uint32_t taken[MAX_PIECES], moved_from[MAX_PIECES], gone = 0, units = 0;
+   memset(moved_from, 0, sizeof(moved_from));
+   for (uint32_t i = 0; i < count; ++i) {
+      in_use += (uint32_t)__builtin_popcount(pieces[i].used);
+      taken[i] = pieces[i].used;
+      gone += pieces[i].moves;
+      assert(!(pieces[i].moves && pieces[i].takes));
+      if (pieces[i].moves)
+         units += (uint32_t)__builtin_popcount(pieces[i].used);
+   }
+   const uint64_t needed = (in_use + 31) / 32;
+   uint64_t best = count > needed ? count - needed : 0;
+   if (best > limit)
+      best = limit;
+   assert(emptied == best && gone == emptied && moved == units);
+   for (uint32_t m = 0; m < moved; ++m) {
+      const struct radv_ps5_compact_move *const move = &moves[m];
+      assert(move->from < count && move->to < count && move->from_unit < 32 && move->to_unit < 32);
+      assert(pieces[move->from].moves && !pieces[move->to].moves && pieces[move->to].takes);
+      assert(pieces[move->from].used & (1u << move->from_unit));          /* a unit in use... */
+      assert(!(moved_from[move->from] & (1u << move->from_unit)));        /* ...moved once */
+      moved_from[move->from] |= 1u << move->from_unit;
+      assert(!(taken[move->to] & (1u << move->to_unit)));                  /* into a free unit */
+      taken[move->to] |= 1u << move->to_unit;
+   }
+   for (uint32_t i = 0; i < count; ++i)
+      assert(!pieces[i].moves || moved_from[i] == pieces[i].used);
+}
+
+int
+main(void)
+{
+   struct radv_ps5_compact_piece pieces[MAX_PIECES];
+   uint32_t moved, emptied;
+
+   /* Two half-used pieces: one goes into the other. */
+   memset(pieces, 0, sizeof(pieces));
+   pieces[0].used = 0x0000ffffu;
+   pieces[1].used = 0xffff0000u;
+   emptied = run(pieces, 2, UINT32_MAX, &moved);
+   check(pieces, 2, UINT32_MAX, emptied, moved);
+   assert(emptied == 1 && moved == 16);
+
+   /* 30, 2, 2 in use (34 units): two pieces are needed, one is emptied, its 2 units into the 30. */
+   memset(pieces, 0, sizeof(pieces));
+   pieces[0].used = 0x3fffffffu;
+   pieces[1].used = 0x3u;
+   pieces[2].used = 0xc0000000u;
+   emptied = run(pieces, 3, UINT32_MAX, &moved);
+   check(pieces, 3, UINT32_MAX, emptied, moved);
+   assert(emptied == 1 && moved == 2);
+
+   /* 20, 20, 20 in use (60 units): two pieces hold them; the third's 20 units split over the two. */
+   memset(pieces, 0, sizeof(pieces));
+   for (uint32_t i = 0; i < 3; ++i)
+      pieces[i].used = 0x000fffffu << (i * 4);
+   emptied = run(pieces, 3, UINT32_MAX, &moved);
+   check(pieces, 3, UINT32_MAX, emptied, moved);
+   assert(emptied == 1 && moved == 20);
+
+   /* Eight pieces with 4 units each: seven fill the first one's 28 free units. */
+   memset(pieces, 0, sizeof(pieces));
+   for (uint32_t i = 0; i < 8; ++i)
+      pieces[i].used = 0xfu << (4 * i);
+   emptied = run(pieces, 8, UINT32_MAX, &moved);
+   check(pieces, 8, UINT32_MAX, emptied, moved);
+   assert(emptied == 7 && moved == 28);
+
+   /* The limit. */
+   emptied = run(pieces, 8, 3, &moved);
+   check(pieces, 8, 3, emptied, moved);
+   assert(emptied == 3 && moved == 12);
+
+   /* Nothing to plan with; nothing that fits. */
+   assert(run(pieces, 0, UINT32_MAX, &moved) == 0 && moved == 0);
+   memset(pieces, 0, sizeof(pieces));
+   pieces[0].used = 0x7fffffffu;
+   pieces[1].used = 0xfffffffeu;
+   emptied = run(pieces, 2, UINT32_MAX, &moved);
+   check(pieces, 2, UINT32_MAX, emptied, moved);
+   assert(emptied == 0 && moved == 0);
+
+   /* Random sets and limits. */
+   uint32_t seed = 12345, total = 0;
+   for (int round = 0; round < 3000; ++round) {
+      const uint32_t count = 1 + (seed = seed * 1103515245u + 12345u) % MAX_PIECES;
+      seed = seed * 1103515245u + 12345u;
+      const uint32_t limit = seed % 4 == 0 ? seed % 64 : UINT32_MAX;
+      for (uint32_t i = 0; i < count; ++i) {
+         seed = seed * 1103515245u + 12345u;
+         uint32_t used = seed;
+         if (seed % 3 == 0)
+            used &= (1u << (seed % 31 + 1)) - 1;
+         if (used == 0)
+            used = 1;
+         if (used == 0xffffffffu)
+            used = 0x7fffffffu;
+         pieces[i] = (struct radv_ps5_compact_piece){.used = used};
+      }
+      emptied = run(pieces, count, limit, &moved);
+      check(pieces, count, limit, emptied, moved);
+      total += emptied;
+   }
+   assert(total > 0);
+   printf("RADV compaction plan: PASS (fixed cases, limits, 3000 random sets: %u pieces emptied)\n", total);
+   return 0;
+}
+'''
+# The compaction itself (tools/radv-compact.inc) against a model of the kernel's memory calls: direct
+# memory in 2 MiB pieces with a tag per 64 KiB slot, and a page table from addresses to slots.
+compact = (root / 'tools/radv-compact.inc').read_text()
+model = r'''
+#include <assert.h>
+#include <inttypes.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define MIN2(a, b) ((a) < (b) ? (a) : (b))
+#define RADV_PS5_LARGE_BYTES UINT64_C(0x200000)
+#define RADV_PS5_DIRECT_TYPE 12
+#define PS5_KERNEL_PROT_CPU_READ 1
+#define PS5_KERNEL_PROT_CPU_WRITE 2
+struct radv_ps5_memory {
+   uint8_t *cpu;
+   uint64_t bytes;
+   int64_t physical;
+   uint32_t granule, granules;
+   bool window_replay;
+   int64_t *pieces;
+   uint16_t *uses;
+   uint32_t *idle_ms;
+   uint16_t *unit_uses;
+   uint32_t *released_ms;
+   bool no_compact;
+   int64_t *unit_phys;
+};
+struct radv_ps5_compact_report {
+   uint32_t partial, partial_free, candidates, emptied, moved, dropped, managed;
+   uint64_t released;
+   int32_t tables_free;
+   bool tables_low, timed_out, broken;
+};
+static int tables_free = 9000;
+static int radv_ps5_compact_tables_free(void) { return tables_free; }
+#define PIECES 64u
+#define UNIT (UINT64_C(64) << 10)
+#define ZERO ((int64_t)(PIECES * RADV_PS5_LARGE_BYTES))
+#define VA_BASE UINT64_C(0x4000000000)
+#define VA_UNITS 16384u /* 1 GiB of addresses for memories */
+#define VIEW_BASE (VA_BASE + VA_UNITS * UNIT)
+#define VIEW_UNITS 64u
+static bool allocated[PIECES];
+static uint64_t content[PIECES * 32];
+static int64_t pages[VA_UNITS + VIEW_UNITS]; /* -2: nothing mapped */
+static unsigned allocations, releases;
+static bool locked;
+
+static int64_t sceKernelGetDirectMemorySize(void) { return (int64_t)(PIECES * RADV_PS5_LARGE_BYTES); }
+static uint64_t page_of(const void *at) { return ((uint64_t)(uintptr_t)at - VA_BASE) / UNIT; }
+static int
+sceKernelAllocateDirectMemory(int64_t lo, int64_t hi, uint64_t length, uint64_t alignment, int type, int64_t *out)
+{
+   (void)lo, (void)hi, (void)alignment, (void)type;
+   assert(length == RADV_PS5_LARGE_BYTES);
+   for (unsigned i = 0; i < PIECES; ++i)
+      if (!allocated[i]) {
+         allocated[i] = true;
+         allocations++;
+         *out = (int64_t)(i * RADV_PS5_LARGE_BYTES);
+         for (unsigned s = 0; s < 32; ++s)
+            content[i * 32 + s] = 0xdead;
+         return 0;
+      }
+   return -1;
+}
+static int
+sceKernelReleaseDirectMemory(int64_t start, uint64_t length)
+{
+   assert(length == RADV_PS5_LARGE_BYTES && start % (int64_t)RADV_PS5_LARGE_BYTES == 0);
+   const unsigned piece = (unsigned)(start / (int64_t)RADV_PS5_LARGE_BYTES);
+   assert(piece < PIECES && allocated[piece]);
+   for (unsigned v = 0; v < VA_UNITS + VIEW_UNITS; ++v) /* nothing may still show it */
+      assert(pages[v] < start || pages[v] >= start + (int64_t)RADV_PS5_LARGE_BYTES);
+   allocated[piece] = false;
+   releases++;
+   return 0;
+}
+static bool
+radv_ps5_map_fixed(uint8_t *at, uint64_t bytes, int64_t physical)
+{
+   assert((uint64_t)(uintptr_t)at % UNIT == 0 && bytes % UNIT == 0 && bytes <= RADV_PS5_LARGE_BYTES);
+   for (uint64_t i = 0; i < bytes / UNIT; ++i)
+      pages[page_of(at) + i] = physical + (int64_t)(i * UNIT);
+   return true;
+}
+static bool radv_ps5_map_fixed_sparse(uint8_t *at, uint64_t bytes, int64_t physical) { (void)at, (void)bytes, (void)physical; return true; }
+static int
+sceKernelMapDirectMemory(void **at, uint64_t bytes, int protection, int flags, int64_t physical, uint64_t alignment)
+{
+   (void)protection, (void)flags, (void)alignment;
+   assert(bytes == RADV_PS5_LARGE_BYTES);
+   for (unsigned v = 0; v < VIEW_UNITS; v += 32)
+      if (pages[VA_UNITS + v] == -2) {
+         for (unsigned i = 0; i < 32; ++i)
+            pages[VA_UNITS + v + i] = physical + (int64_t)(i * UNIT);
+         *at = (void *)(uintptr_t)(VIEW_BASE + v * UNIT);
+         return 0;
+      }
+   return -1;
+}
+static int
+sceKernelMunmap(void *at, uint64_t bytes)
+{
+   for (uint64_t i = 0; i < bytes / UNIT; ++i)
+      pages[page_of(at) + i] = -2;
+   return 0;
+}
+static uint64_t *
+slot_content(const void *at)
+{
+   const int64_t physical = pages[page_of(at)];
+   assert(physical >= 0 && physical < ZERO && physical % (int64_t)UNIT == 0);
+   return &content[physical / (int64_t)UNIT];
+}
+static void radv_ps5_compact_copy(uint8_t *to, const uint8_t *from) { *slot_content(to) = *slot_content(from); }
+static void radv_ps5_cpu_flush(const void *at, uint64_t bytes) { (void)at, (void)bytes; }
+static int64_t radv_ps5_zero_block(void) { return ZERO; }
+static int64_t radv_ps5_zero_block_for(void *at) { (void)at; return ZERO; }
+static uint64_t radv_ps5_now_ns(void) { return 0; }
+static uint32_t clock_ms = 100000;
+static uint32_t radv_ps5_trim_now_ms(void) { return clock_ms; }
+static uint32_t radv_ps5_trim_quarantine_ms(void) { return 2000; }
+static bool radv_ps5_trim_trylock(void) { if (locked) return false; locked = true; return true; }
+static void radv_ps5_trim_acquire(void) { assert(!locked); locked = true; }
+static void radv_ps5_trim_release(void) { assert(locked); locked = false; }
+static struct radv_ps5_memory *radv_ps5_trim_tracked[64];
+static uint32_t radv_ps5_trim_count;
+static uint64_t radv_ps5_trim_retaken;
+static bool radv_ps5_trim_pieces(struct radv_ps5_memory *memory) { return memory->pieces != NULL; }
+static void
+radv_ps5_trim_untrack(struct radv_ps5_memory *memory)
+{
+   radv_ps5_trim_acquire();
+   for (uint32_t i = 0; i < radv_ps5_trim_count; ++i)
+      if (radv_ps5_trim_tracked[i] == memory) {
+         radv_ps5_trim_tracked[i] = radv_ps5_trim_tracked[--radv_ps5_trim_count];
+         break;
+      }
+   free(memory->uses);
+   free(memory->idle_ms);
+   free(memory->unit_uses);
+   free(memory->released_ms);
+   memory->uses = NULL;
+   memory->idle_ms = NULL;
+   memory->unit_uses = NULL;
+   memory->released_ms = NULL;
+   radv_ps5_trim_release();
+}
+static int radv_ps5_region;
+static void radv_ps5_granules_give(int *region, uint32_t granule, uint32_t granules) { (void)region, (void)granule, (void)granules; }
+''' + plan + compact + r'''
+#define MEMORIES 12u
+#define GRANULES 4u
+static struct radv_ps5_memory memories[MEMORIES];
+static uint32_t seed;
+static uint32_t next(void) { return seed = seed * 1103515245u + 12345u; }
+static uint64_t tag(uint32_t m, uint32_t unit) { return ((uint64_t)m << 32) | unit | (UINT64_C(1) << 63); }
+
+static void
+verify(void)
+{
+   assert(!locked);
+   uint64_t free_slots = 0;
+   for (unsigned piece = 0; piece < PIECES && radv_ps5_slots; ++piece) {
+      uint32_t mask = 0;
+      for (unsigned s = 0; s < 32; ++s) {
+         const struct radv_ps5_slot *const shown = &radv_ps5_slots[piece * 32 + s];
+         if (!shown->memory)
+            continue;
+         mask |= 1u << s;
+         if (shown->memory == RADV_PS5_SLOT_HELD)
+            continue; /* a retired memory's: its copy checks it (retired_check) */
+         assert(shown->memory->unit_phys && shown->memory->unit_phys[shown->unit] ==
+                                               (int64_t)(piece * RADV_PS5_LARGE_BYTES + s * UNIT));
+      }
+      assert(mask == radv_ps5_slot_masks[piece]);
+      if (mask)
+         free_slots += 32 - (uint64_t)__builtin_popcount(mask);
+      assert(!mask || allocated[piece]);
+   }
+   assert(!radv_ps5_slots || free_slots == radv_ps5_free_slots);
+   for (uint32_t m = 0; m < MEMORIES; ++m) {
+      struct radv_ps5_memory *const memory = &memories[m];
+      if (!memory->cpu)
+         continue;
+      for (uint32_t unit = 0; unit < GRANULES * 32; ++unit) {
+         const int64_t shown = pages[page_of(memory->cpu) + unit];
+         if (memory->unit_phys) {
+            assert(shown == (memory->unit_phys[unit] >= 0 ? memory->unit_phys[unit] : shown));
+            assert(memory->unit_phys[unit] >= 0 || shown >= ZERO);
+         } else {
+            const int64_t piece = memory->pieces[unit / 32];
+            assert(piece >= 0 ? shown == piece + (int64_t)(unit % 32 * UNIT) : shown >= ZERO);
+         }
+         if (memory->unit_uses && memory->unit_uses[unit])
+            assert(shown >= 0 && shown < ZERO && content[shown / (int64_t)UNIT] == tag(m, unit));
+      }
+   }
+   /* every piece allocated is either a managed piece some unit shows or an unmanaged memory's own */
+   for (unsigned piece = 0; piece < PIECES; ++piece) {
+      if (!allocated[piece] || (radv_ps5_slots && radv_ps5_slot_masks[piece]))
+         continue;
+      bool owned = false;
+      for (uint32_t m = 0; m < MEMORIES; ++m)
+         for (uint32_t g = 0; memories[m].cpu && memories[m].pieces && g < GRANULES; ++g)
+            owned |= memories[m].pieces[g] == (int64_t)(piece * RADV_PS5_LARGE_BYTES);
+      assert(owned);
+   }
+}
+
+/* A retired memory (Mesa f5610fe's retire keeps a copy of the struct; the buffer object goes): its
+ * units keep their slots, held, their data intact, until the copy is freed. */
+static struct radv_ps5_memory retired;
+static uint32_t retired_index = UINT32_MAX;
+static void
+retired_check(void)
+{
+   if (!retired.cpu || !retired.unit_phys)
+      return;
+   for (uint32_t unit = 0; unit < GRANULES * 32; ++unit) {
+      const int64_t physical = retired.unit_phys[unit];
+      if (physical < 0)
+         continue;
+      assert(radv_ps5_slots[physical / (int64_t)UNIT].memory == RADV_PS5_SLOT_HELD);
+      assert(radv_ps5_slot_masks[physical / (int64_t)RADV_PS5_LARGE_BYTES] & (1u << (physical % (int64_t)RADV_PS5_LARGE_BYTES / (int64_t)UNIT)));
+      assert(pages[page_of(retired.cpu) + unit] == physical);
+   }
+}
+
+static void
+bind(uint32_t m, uint32_t first, uint32_t count)
+{
+   struct radv_ps5_memory *const memory = &memories[m];
+   radv_ps5_trim_acquire();
+   if (memory->unit_phys)
+      assert(radv_ps5_compact_retake(memory, (uint64_t)first * UNIT, (uint64_t)count * UNIT));
+   radv_ps5_trim_release();
+   for (uint32_t unit = first; unit < first + count; ++unit) {
+      if (!memory->unit_uses[unit]++)
+         *slot_content(radv_ps5_unit_address(memory, unit)) = tag(m, unit);
+      memory->uses[unit / 32]++;
+   }
+}
+
+static void
+unbind_all(uint32_t m, uint32_t granule)
+{
+   struct radv_ps5_memory *const memory = &memories[m];
+   for (uint32_t unit = granule * 32; unit < granule * 32 + 32; ++unit) {
+      memory->uses[granule] -= memory->unit_uses[unit];
+      memory->unit_uses[unit] = 0;
+   }
+   memory->released_ms[granule] = clock_ms;
+   memory->idle_ms[granule] = clock_ms;
+}
+
+static uint32_t
+round_trip(uint32_t round)
+{
+   seed = round * 7919u + 1;
+   memset(allocated, 0, sizeof(allocated));
+   for (unsigned v = 0; v < VA_UNITS + VIEW_UNITS; ++v)
+      pages[v] = -2;
+   radv_ps5_trim_count = 0;
+   for (uint32_t m = 0; m < MEMORIES; ++m) {
+      struct radv_ps5_memory *const memory = &memories[m];
+      *memory = (struct radv_ps5_memory){
+         .cpu = (uint8_t *)(uintptr_t)(VA_BASE + m * GRANULES * RADV_PS5_LARGE_BYTES),
+         .bytes = GRANULES * RADV_PS5_LARGE_BYTES, .physical = -1,
+         .pieces = malloc(GRANULES * sizeof(int64_t)), .uses = calloc(GRANULES, 2), .idle_ms = calloc(GRANULES, 4),
+         .unit_uses = calloc(GRANULES * 32, 2), .released_ms = calloc(GRANULES, 4),
+         .no_compact = m == MEMORIES - 1 && round % 2}; /* now and then one that must stay */
+      for (uint32_t g = 0; g < GRANULES; ++g) {
+         assert(sceKernelAllocateDirectMemory(0, 0, RADV_PS5_LARGE_BYTES, 0, 0, &memory->pieces[g]) == 0);
+         radv_ps5_map_fixed(memory->cpu + g * RADV_PS5_LARGE_BYTES, RADV_PS5_LARGE_BYTES, memory->pieces[g]);
+      }
+      radv_ps5_trim_tracked[radv_ps5_trim_count++] = memory;
+      for (uint32_t b = next() % 9; b--;) {
+         const uint32_t first = next() % (GRANULES * 32), count = 1 + next() % 6;
+         bind(m, first, MIN2(count, GRANULES * 32 - first));
+      }
+   }
+   verify();
+   uint32_t emptied = 0;
+   for (int pass = 0; pass < 3; ++pass) {
+      struct radv_ps5_compact_report report;
+      const unsigned before = releases;
+      assert(radv_ps5_compact_pass(UINT64_C(256) << 20, false, &report));
+      assert(!report.broken && report.released == (uint64_t)(releases - before) * RADV_PS5_LARGE_BYTES);
+      emptied += report.emptied;
+      verify();
+      retired_check();
+      /* binds over units that show the zero block take free slots; resources go; granules are trimmed */
+      for (uint32_t b = next() % 6; b--;) {
+         const uint32_t m = next() % MEMORIES, first = next() % (GRANULES * 32), count = 1 + next() % 4;
+         if (memories[m].cpu)
+            bind(m, first, MIN2(count, GRANULES * 32 - first));
+      }
+      verify();
+      if (pass == 1) {
+         /* Retire one managed memory, as radv_ps5_trim_detach does before the struct is copied. */
+         for (uint32_t m = 0; m < MEMORIES && retired_index == UINT32_MAX; ++m) {
+            if (!memories[m].unit_phys)
+               continue;
+            radv_ps5_trim_untrack(&memories[m]);
+            radv_ps5_trim_acquire();
+            memories[m].no_compact = true;
+            radv_ps5_compact_hold(&memories[m]);
+            radv_ps5_trim_release();
+            retired = memories[m];
+            memset(&memories[m], 0, sizeof(memories[m])); /* the buffer object is gone */
+            retired_index = m;
+         }
+         retired_check();
+      }
+      if (pass == 2) {
+         /* What the GPU had to run has run: the copy is freed. */
+         if (retired_index != UINT32_MAX) {
+            assert(radv_ps5_compact_free(&retired));
+            retired_index = UINT32_MAX;
+         }
+      }
+      verify();
+      retired_check();
+      const uint32_t m = next() % MEMORIES, g = next() % GRANULES;
+      if (!memories[m].cpu)
+         continue;
+      unbind_all(m, g);
+      clock_ms += 3000;
+      radv_ps5_trim_acquire();
+      if (memories[m].unit_phys)
+         radv_ps5_compact_trim_granule(&memories[m], g, ZERO);
+      radv_ps5_trim_release();
+      verify();
+   }
+   for (uint32_t m = 0; m < MEMORIES; ++m) {
+      struct radv_ps5_memory *const memory = &memories[m];
+      if (!memory->cpu)
+         continue;
+      if (!radv_ps5_compact_free(memory)) {
+         radv_ps5_trim_untrack(memory);
+         sceKernelMunmap(memory->cpu, memory->bytes);
+         for (uint32_t g = 0; g < GRANULES; ++g)
+            if (memory->pieces[g] >= 0)
+               sceKernelReleaseDirectMemory(memory->pieces[g], RADV_PS5_LARGE_BYTES);
+         free(memory->pieces);
+         memset(memory, 0, sizeof(*memory));
+      }
+      verify();
+   }
+   for (unsigned piece = 0; piece < PIECES; ++piece)
+      assert(!allocated[piece]);
+   assert(radv_ps5_free_slots == 0);
+   return emptied;
+}
+
+int
+main(void)
+{
+   uint32_t emptied = 0;
+   for (uint32_t round = 0; round < 400; ++round)
+      emptied += round_trip(round);
+   assert(emptied > 0);
+   /* Page tables under the mark: a pass moves nothing. */
+   tables_free = 100;
+   memset(allocated, 0, sizeof(allocated));
+   {
+      struct radv_ps5_compact_report report;
+      assert(radv_ps5_compact_pass(UINT64_C(256) << 20, false, &report) && report.tables_low && !report.moved &&
+             !report.emptied && report.tables_free == 100);
+   }
+   tables_free = 9000;
+   printf("RADV compaction moves: PASS (400 rounds of binds, passes, trims and frees: %u pieces emptied, every unit in use "
+          "read back through its address, %u pieces taken, %u given back)\n", emptied, allocations, releases);
+   return 0;
+}
+'''
+with tempfile.TemporaryDirectory(prefix='eglantine-radv-compact-') as directory:
+    for name, text in (('plan', code), ('moves', model)):
+        source_path = Path(directory) / f'{name}.c'
+        executable = Path(directory) / name
+        source_path.write_text(text)
+        subprocess.run(['cc', '-std=c11', '-O1', '-g', '-Wall', '-Wextra', '-Werror', '-Wno-unused-function',
+                        str(source_path), '-o', str(executable)], check=True)
+        subprocess.run([str(executable)], check=True)
