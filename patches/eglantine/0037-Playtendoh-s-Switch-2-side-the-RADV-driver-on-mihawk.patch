+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""RADV: a pipeline whose shader the device had no memory for fails, instead of being made without it.
+
+radv_shader_create returns NULL when its code cannot be placed in device memory (the shader arena
+refused), and the graphics and compute compiles stored that NULL and returned the pipeline as made:
+the first draw with it read the vertex stage through a null pointer (Mario Kart World on the PS5,
+19 Nov, the pool at its wall). The compiles now return VK_ERROR_OUT_OF_DEVICE_MEMORY (the core draws
+nothing with a pipeline whose build failed, and builds it again later) and leave such a pipeline out
+of the cache; the uncached create no longer reads the shader it did not get. Applied to the driver
+checkout after patch-radv-wsi.py; running it again changes nothing. Patches the driver build
+export, never the Mesa checkout.
+"""
+from pathlib import Path
+import sys
+import hashlib
+
+fingerprint = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
+if sys.argv[1:2] == ['--digest']:
+    print(fingerprint)
+    raise SystemExit(0)
+if sys.argv[1:2] == ['--check']:
+    stamp = Path(sys.argv[2])
+    raise SystemExit(0 if stamp.is_file() and stamp.read_text().strip() == fingerprint else 1)
+
+root = Path(__file__).resolve().parents[1]
+src = Path(sys.argv[1]) if len(sys.argv) > 1 else root.parent / 'mihawk-vulkan-review/.deps/work/radv-src'
+vulkan = src / 'src/amd/vulkan'
+changed = False
+
+
+def edit(name, marker, anchor, replacement, what):
+    """Replace anchor once, unless the marker (the edit's own code) is already there."""
+    global changed
+    path = vulkan / name
+    text = path.read_text()
+    if marker in text:
+        return
+    assert text.count(anchor) == 1, f'{name}: {what} changed'
+    path.write_text(text.replace(anchor, replacement))
+    changed = True
+
+
+# The uncached create: a shader not made is not read.
+edit('radv_pipeline_cache.c', 'radv_shader_create_uncached(device, binary, false, NULL, dbg, &shader) != VK_SUCCESS',
+     '''      radv_shader_create_uncached(device, binary, false, NULL, dbg, &shader);
+''', '''      if (radv_shader_create_uncached(device, binary, false, NULL, dbg, &shader) != VK_SUCCESS || !shader)
+         return NULL; /* EglantinePS5: no device memory for its code (the caller fails the pipeline) */
+''', 'radv_shader_create (uncached)')
+
+# Graphics: every stage compiled has its shader, the copy shader and the geometry-as-compute
+# shaders too, or the pipeline fails and is not cached.
+edit('radv_pipeline_graphics.c', 'EglantinePS5: a shader the device had no memory for',
+     '''   radv_graphics_shaders_create(device, cache, skip_shaders_cache, pipeline->base.shaders, binaries, debug,
+                                &pipeline->base.gs_copy_shader, gs_copy_binary, &gs_copy_debug);
+''', '''   radv_graphics_shaders_create(device, cache, skip_shaders_cache, pipeline->base.shaders, binaries, debug,
+                                &pipeline->base.gs_copy_shader, gs_copy_binary, &gs_copy_debug);
+   /* EglantinePS5: a shader the device had no memory for is NULL here; the pipeline fails rather than
+    * being made without that stage (a draw then read the vertex stage through a null pointer). */
+   for (int i = 0; i < MESA_VULKAN_SHADER_STAGES; ++i) {
+      if (binaries[i] && !pipeline->base.shaders[i])
+         result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+   if (gs_copy_binary && !pipeline->base.gs_copy_shader)
+      result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+''', 'radv_graphics_shaders_create call')
+edit('radv_pipeline_graphics.c', 'EglantinePS5: as above, for the geometry-as-compute shaders',
+     '''            pipeline->base.gs_compute->shaders[i] =
+               radv_shader_create(device, cache, gs_compute.binaries[i], true, &gs_compute.debug[i]);
+''', '''            pipeline->base.gs_compute->shaders[i] =
+               radv_shader_create(device, cache, gs_compute.binaries[i], true, &gs_compute.debug[i]);
+         /* EglantinePS5: as above, for the geometry-as-compute shaders. */
+         if (gs_compute.binaries[i] && pipeline->base.gs_compute && !pipeline->base.gs_compute->shaders[i])
+            result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+''', 'geometry-as-compute shader creation')
+edit('radv_pipeline_graphics.c', '   if (!skip_shaders_cache && result == VK_SUCCESS) {\n      radv_pipeline_cache_insert(device, cache, &pipeline->base);\n   }\n\n   free(gs_copy_binary);',
+     '''   if (!skip_shaders_cache) {
+      radv_pipeline_cache_insert(device, cache, &pipeline->base);
+   }
