diff --git a/tools/radv-compact-plan.inc b/tools/radv-compact-plan.inc
new file mode 100644
index 0000000..9b4fdd3
--- /dev/null
+++ b/tools/radv-compact-plan.inc
@@ -0,0 +1,72 @@
+/* EglantinePS5 memory compaction's planner (tools/patch-radv-trim.py inlines it into the PS5 winsys;
+ * tools/check-radv-compact.py builds it on the host). A piece is a 2 MiB granule of driver memory
+ * that is partly used: 1 to 31 of its 32 units (64 KiB each) have a resource bound over them. */
+#define RADV_PS5_COMPACT_UNIT (UINT64_C(64) << 10)
+#define RADV_PS5_COMPACT_UNITS 32u
+
+struct radv_ps5_compact_piece {
+   /* Its units in use, a bit each. */
+   uint32_t used;
+   /* Where it is: the memory and its granule (the pass reads them; the plan does not). */
+   struct radv_ps5_memory *memory;
+   uint32_t granule;
+   /* The plan: whether its units move out (and it is emptied), or it takes others' units. */
+   bool moves;
+   bool takes;
+};
+
+/* One unit's move: from a unit of one piece to a free unit of another. */
+struct radv_ps5_compact_move {
+   uint32_t from, from_unit, to, to_unit;
+};
+
+/* The pieces, most units in use first. */
+static void
+radv_ps5_compact_order(const struct radv_ps5_compact_piece *pieces, uint32_t count, uint32_t *order)
+{
+   uint32_t at = 0;
+   for (int used = (int)RADV_PS5_COMPACT_UNITS; used >= 0; --used) {
+      for (uint32_t i = 0; i < count; ++i) {
+         if (__builtin_popcount(pieces[i].used) == used)
+            order[at++] = i;
+      }
+   }
+}
+
+/* Units move one by one, so any m of n pieces can be emptied into the others when all their units in
+ * use fit in n - m pieces: m = n - ceil(units in use / 32). The m used least move (the least to copy),
+ * unit by unit into the free units of the rest, most used first. At most `limit` pieces are emptied;
+ * `moves` has room for 31 a piece. Returns how many; `move_count` is the units moved. */
+static uint32_t
+radv_ps5_compact_plan(struct radv_ps5_compact_piece *pieces, const uint32_t *order, uint32_t count,
+                      uint32_t limit, struct radv_ps5_compact_move *moves, uint32_t *move_count)
+{
+   uint64_t in_use = 0;
+   for (uint32_t i = 0; i < count; ++i) {
+      pieces[i].moves = false;
+      pieces[i].takes = false;
+      in_use += (uint32_t)__builtin_popcount(pieces[i].used);
+   }
+   *move_count = 0;
+   const uint64_t needed = (in_use + RADV_PS5_COMPACT_UNITS - 1) / RADV_PS5_COMPACT_UNITS;
+   uint32_t emptied = count > needed ? (uint32_t)(count - needed) : 0;
+   if (emptied > limit)
+      emptied = limit;
+   uint32_t host = 0, host_free = emptied ? ~pieces[order[0]].used : 0;
+   for (uint32_t g = count; g-- > count - emptied;) {
+      struct radv_ps5_compact_piece *const guest = &pieces[order[g]];
+      guest->moves = true;
+      for (uint32_t used = guest->used; used; used &= used - 1) {
+         while (!host_free) {
+            host++;
+            host_free = ~pieces[order[host]].used;
+         }
+         const uint32_t to_unit = (uint32_t)__builtin_ctz(host_free);
+         host_free &= host_free - 1;
+         pieces[order[host]].takes = true;
+         moves[(*move_count)++] = (struct radv_ps5_compact_move){
+            .from = order[g], .from_unit = (uint32_t)__builtin_ctz(used), .to = order[host], .to_unit = to_unit};
+      }
+   }
+   return emptied;
+}
diff --git a/tools/radv-compact.inc b/tools/radv-compact.inc
new file mode 100644
index 0000000..55f9f9b
--- /dev/null
+++ b/tools/radv-compact.inc
@@ -0,0 +1,547 @@
+/* EglantinePS5 memory compaction (tools/patch-radv-trim.py inlines this into the PS5 winsys's trim
+ * block, after radv_ps5_memory_use; tools/check-radv-compact.py runs it on the host against a model of
+ * the kernel's memory calls). The planner is tools/radv-compact-plan.inc.
+ *
+ * Driver memory the compaction manages keeps where each of its 64 KiB units is (unit_phys: a physical
+ * address, or -1 where the unit shows the zero block), and each 2 MiB piece of direct memory behind it
+ * keeps which unit shows each of its 32 slots. A piece goes back when no unit shows it any longer.
+ * A pass, with the GPU idle and nothing submitted, copies the units in use of the pieces used least
+ * into free slots of the pieces used most and maps them there, so the emptied pieces go back whole;
+ * a bind over a unit that shows the zero block takes a free slot of such a piece before a new one.
+ * Every function here runs with the trim lock held unless it says otherwise. */
+
+struct radv_ps5_slot {
+   struct radv_ps5_memory *memory; /* NULL: free */
+   uint32_t unit;
+};
+static struct radv_ps5_slot *radv_ps5_slots;
+static uint32_t *radv_ps5_slot_masks; /* per piece: the slots some unit shows */
+static uint64_t radv_ps5_piece_count; /* the pieces the table covers: direct memory / 2 MiB */
+static uint64_t radv_ps5_free_slots;  /* free slots of pieces some unit shows */
+static uint64_t radv_ps5_slot_cursor; /* where the next search for a free slot starts */
+static bool radv_ps5_compact_broken;  /* a mapping failed in a pass: no more passes */
+/* A slot shown by memory that is retired (radv_ps5_trim_detach: its buffer is gone, its memory held
+ * until the GPU has run what was submitted before): neither free nor movable, until the retired copy
+ * is freed (radv_ps5_compact_free clears it). */
+#define RADV_PS5_SLOT_HELD ((struct radv_ps5_memory *)(uintptr_t)1)
+
+static bool
+radv_ps5_slots_ready(void)
+{
+   if (radv_ps5_slots)
+      return true;
+   const uint64_t pieces =
+      ((uint64_t)sceKernelGetDirectMemorySize() + RADV_PS5_LARGE_BYTES - 1) / RADV_PS5_LARGE_BYTES;
+   radv_ps5_slots = calloc(pieces * RADV_PS5_COMPACT_UNITS, sizeof(*radv_ps5_slots));
+   radv_ps5_slot_masks = calloc(pieces, sizeof(*radv_ps5_slot_masks));
+   if (!radv_ps5_slots || !radv_ps5_slot_masks) {
+      free(radv_ps5_slots);
+      free(radv_ps5_slot_masks);
+      radv_ps5_slots = NULL;
+      radv_ps5_slot_masks = NULL;
+      return false;
+   }
+   radv_ps5_piece_count = pieces;
+   return true;
+}
+
+static uint64_t
+radv_ps5_piece_of(int64_t physical)
+{
+   return (uint64_t)physical / RADV_PS5_LARGE_BYTES;
+}
+
+static uint32_t
+radv_ps5_slot_of(int64_t physical)
+{
+   return (uint32_t)((uint64_t)physical % RADV_PS5_LARGE_BYTES / RADV_PS5_COMPACT_UNIT);
+}
+
+static int64_t
+radv_ps5_slot_physical(uint64_t piece, uint32_t slot)
+{
+   return (int64_t)(piece * RADV_PS5_LARGE_BYTES + (uint64_t)slot * RADV_PS5_COMPACT_UNIT);
+}
+
+static uint8_t *
+radv_ps5_unit_address(const struct radv_ps5_memory *memory, uint32_t unit)
+{
+   return memory->cpu + (uint64_t)unit * RADV_PS5_COMPACT_UNIT;
+}
+
+/* The slots a piece's units show: the free-slot count follows, and a piece no unit shows any longer
+ * goes back. Returns the bytes given back. */
+static uint64_t
+radv_ps5_piece_mask(uint64_t piece, uint32_t mask)
+{
+   const uint32_t old = radv_ps5_slot_masks[piece];
+   radv_ps5_free_slots -= old ? RADV_PS5_COMPACT_UNITS - (uint32_t)__builtin_popcount(old) : 0;
+   radv_ps5_free_slots += mask ? RADV_PS5_COMPACT_UNITS - (uint32_t)__builtin_popcount(mask) : 0;
+   radv_ps5_slot_masks[piece] = mask;
+   if (mask || !old)
+      return 0;
+   if (sceKernelReleaseDirectMemory((int64_t)(piece * RADV_PS5_LARGE_BYTES), RADV_PS5_LARGE_BYTES) != 0) {
+      fprintf(stderr, "radv/ps5: compaction: a piece no unit shows would not go back\n");
+      return 0;
+   }
+   return RADV_PS5_LARGE_BYTES;
+}
+
+static void
+radv_ps5_slot_set(int64_t physical, struct radv_ps5_memory *memory, uint32_t unit)
+{
+   const uint64_t piece = radv_ps5_piece_of(physical);
+   const uint32_t slot = radv_ps5_slot_of(physical);
+   radv_ps5_slots[piece * RADV_PS5_COMPACT_UNITS + slot] = (struct radv_ps5_slot){.memory = memory, .unit = unit};
+   radv_ps5_piece_mask(piece, radv_ps5_slot_masks[piece] | (1u << slot));
+}
+
+/* No unit shows the slot any longer (its address was mapped elsewhere or unmapped first). */
+static uint64_t
+radv_ps5_slot_clear(int64_t physical)
+{
+   const uint64_t piece = radv_ps5_piece_of(physical);
+   const uint32_t slot = radv_ps5_slot_of(physical);
+   radv_ps5_slots[piece * RADV_PS5_COMPACT_UNITS + slot] = (struct radv_ps5_slot){0};
+   return radv_ps5_piece_mask(piece, radv_ps5_slot_masks[piece] & ~(1u << slot));
+}
+
+/* `unit` shows the zero block now (the caller mapped it): its slot is free. */
+static uint64_t
+radv_ps5_unit_dropped(struct radv_ps5_memory *memory, uint32_t unit)
+{
+   const int64_t physical = memory->unit_phys[unit];
+   if (physical < 0)
+      return 0;
+   memory->unit_phys[unit] = -1;
+   return radv_ps5_slot_clear(physical);
+}
+
+static bool
+radv_ps5_units_map(struct radv_ps5_memory *memory, uint32_t unit, uint32_t count, int64_t physical)
+{
+   return radv_ps5_map_fixed(radv_ps5_unit_address(memory, unit), (uint64_t)count * RADV_PS5_COMPACT_UNIT, physical);
+}
+
+/* The memory as units, its pieces in the table. Only memory the CPU never reaches (no_compact is set
+ * for the rest when it is made, and by a sparse bind or a free). */
+static bool
+radv_ps5_compact_manage(struct radv_ps5_memory *memory)
+{
+   if (memory->unit_phys)
+      return true;
+   if (memory->no_compact || !memory->unit_uses || !radv_ps5_slots_ready() || !radv_ps5_trim_pieces(memory))
+      return false;
+   const uint64_t granules = memory->bytes / RADV_PS5_LARGE_BYTES;
+   for (uint64_t g = 0; g < granules; ++g) {
+      const int64_t piece = memory->pieces[g];
+      if (piece >= 0 && (piece % (int64_t)RADV_PS5_LARGE_BYTES || radv_ps5_piece_of(piece) >= radv_ps5_piece_count ||
+                         radv_ps5_slot_masks[radv_ps5_piece_of(piece)]))
+         return false;
+   }
+   int64_t *const phys = malloc(granules * RADV_PS5_COMPACT_UNITS * sizeof(*phys));
+   if (!phys)
+      return false;
+   memory->unit_phys = phys;
+   for (uint64_t g = 0; g < granules; ++g) {
+      const int64_t piece = memory->pieces[g];
+      for (uint32_t k = 0; k < RADV_PS5_COMPACT_UNITS; ++k) {
+         const uint32_t unit = (uint32_t)(g * RADV_PS5_COMPACT_UNITS + k);
+         phys[unit] = piece >= 0 ? piece + (int64_t)(k * RADV_PS5_COMPACT_UNIT) : -1;
+         if (piece >= 0)
+            radv_ps5_slot_set(phys[unit], memory, unit);
+      }
+      memory->pieces[g] = -1;
+   }
+   return true;
+}
+
+/* A free slot of a piece some unit shows, else slot 0 of a new piece (shown by none yet); -1 when the
+ * pool has no piece. */
+static int64_t
+radv_ps5_free_slot(void)
+{
+   for (uint64_t i = 0; radv_ps5_free_slots && i < radv_ps5_piece_count; ++i) {
+      const uint64_t piece = (radv_ps5_slot_cursor + i) % radv_ps5_piece_count;
+      const uint32_t mask = radv_ps5_slot_masks[piece];
+      if (mask && mask != UINT32_MAX) {
+         radv_ps5_slot_cursor = piece;
+         return radv_ps5_slot_physical(piece, (uint32_t)__builtin_ctz(~mask));
+      }
+   }
+   int64_t physical = -1;
+   if (sceKernelAllocateDirectMemory(0, sceKernelGetDirectMemorySize(), RADV_PS5_LARGE_BYTES, RADV_PS5_LARGE_BYTES,
+                                     RADV_PS5_DIRECT_TYPE, &physical) != 0)
+      return -1;
+   if (radv_ps5_piece_of(physical) >= radv_ps5_piece_count) {
+      sceKernelReleaseDirectMemory(physical, RADV_PS5_LARGE_BYTES);
+      return -1;
+   }
+   radv_ps5_slot_cursor = radv_ps5_piece_of(physical);
+   radv_ps5_trim_retaken += RADV_PS5_LARGE_BYTES;
+   return physical;
+}
+
+/* A bind over units of managed memory that show the zero block: each takes a free slot. False: no
+ * memory (the units taken keep theirs). */
+static bool
+radv_ps5_compact_retake(struct radv_ps5_memory *memory, uint64_t offset, uint64_t size)
+{
+   const uint32_t first = (uint32_t)(offset / RADV_PS5_COMPACT_UNIT);
+   const uint32_t last = (uint32_t)MIN2((offset + size - 1) / RADV_PS5_COMPACT_UNIT,
+                                        memory->bytes / RADV_PS5_COMPACT_UNIT - 1);
+   for (uint32_t unit = first; unit <= last; ++unit) {
+      if (memory->unit_phys[unit] >= 0)
+         continue;
+      const int64_t physical = radv_ps5_free_slot();
+      if (physical < 0)
+         return false;
+      if (!radv_ps5_units_map(memory, unit, 1, physical)) {
+         if (!radv_ps5_slot_masks[radv_ps5_piece_of(physical)])
+            sceKernelReleaseDirectMemory(physical, RADV_PS5_LARGE_BYTES);
+         return false;
+      }
+      memory->unit_phys[unit] = physical;
+      radv_ps5_slot_set(physical, memory, unit);
+   }
+   return true;
+}
+
+/* The trim, for a granule of managed memory nothing is bound over: it shows the zero block, and the
+ * slots its units showed are free. Returns the bytes given back. */
+static uint64_t
+radv_ps5_compact_trim_granule(struct radv_ps5_memory *memory, uint64_t granule, int64_t zero)
+{
+   const uint32_t first = (uint32_t)(granule * RADV_PS5_COMPACT_UNITS);
+   bool shown = false;
+   for (uint32_t k = 0; k < RADV_PS5_COMPACT_UNITS; ++k)
+      shown |= memory->unit_phys[first + k] >= 0;
+   if (!shown || !radv_ps5_units_map(memory, first, RADV_PS5_COMPACT_UNITS, zero))
+      return 0;
+   uint64_t returned = 0;
+   for (uint32_t k = 0; k < RADV_PS5_COMPACT_UNITS; ++k)
+      returned += radv_ps5_unit_dropped(memory, first + k);
+   return returned;
+}
+
+/* The slots a managed memory shows are held (its buffer retired; the copy upstream keeps of the memory
+ * frees them). */
+static void
+radv_ps5_compact_hold(struct radv_ps5_memory *memory)
+{
+   if (!memory->unit_phys || !radv_ps5_slots)
+      return;
+   const uint32_t units = (uint32_t)(memory->bytes / RADV_PS5_COMPACT_UNIT);
+   for (uint32_t unit = 0; unit < units; ++unit) {
+      const int64_t physical = memory->unit_phys[unit];
+      if (physical >= 0)
+         radv_ps5_slots[radv_ps5_piece_of(physical) * RADV_PS5_COMPACT_UNITS + radv_ps5_slot_of(physical)].memory =
+            RADV_PS5_SLOT_HELD;
+   }
+}
+
+/* Called by radv_ps5_memory_free without the trim lock: true when the memory is managed, and then it
+ * is freed here. Either way none of it is managed from now on. */
+static bool
+radv_ps5_compact_free(struct radv_ps5_memory *memory)
+{
+   radv_ps5_trim_acquire();
+   memory->no_compact = true;
+   int64_t *const phys = memory->unit_phys;
+   radv_ps5_trim_release();
+   if (!phys)
+      return false;
+   const uint32_t units = (uint32_t)(memory->bytes / RADV_PS5_COMPACT_UNIT);
+   radv_ps5_trim_untrack(memory);
+   const int32_t gone = sceKernelMunmap(memory->cpu, memory->bytes);
+   if (gone != 0)
+      fprintf(stderr, "radv/ps5: sceKernelMunmap(%p, %" PRIu64 ") failed: 0x%08x\n", (void *)memory->cpu,
+              memory->bytes, (unsigned)gone);
+   radv_ps5_granules_give(&radv_ps5_region, memory->granule, memory->granules);
+   radv_ps5_trim_acquire();
+   for (uint32_t unit = 0; unit < units; ++unit) {
+      if (phys[unit] >= 0)
+         radv_ps5_slot_clear(phys[unit]);
+   }
+   memory->unit_phys = NULL;
+   radv_ps5_trim_release();
+   free(phys);
+   free(memory->pieces);
+   *memory = (struct radv_ps5_memory){.physical = -1};
+   return true;
+}
+
+/* A sparse bind of managed memory (radv_ps5_vrange_bind), without the trim lock: unit by unit, and the
+ * memory is never moved again, since the sparse range shows its slots by address. */
+bool
+radv_ps5_compact_map_units(struct radv_ps5_memory *memory, void *at, uint64_t bytes, uint64_t offset)
+{
+   radv_ps5_trim_acquire();
+   memory->no_compact = true;
+   bool ok = true;
+   for (uint64_t done = 0; done < bytes && ok;) {
+      const uint64_t inner = (offset + done) % RADV_PS5_COMPACT_UNIT;
+      const uint64_t length = MIN2(bytes - done, RADV_PS5_COMPACT_UNIT - inner);
+      const int64_t physical = memory->unit_phys[(offset + done) / RADV_PS5_COMPACT_UNIT];
+      const int64_t source = physical >= 0 ? physical + (int64_t)inner : radv_ps5_zero_block_for((uint8_t *)at + done);
+      ok = source >= 0 && radv_ps5_map_fixed_sparse((uint8_t *)at + done, length, source);
+      done += length;
+   }
+   radv_ps5_trim_release();
+   return ok;
+}
+
+/* Whether a piece's units may move or go: none of memory that must stay, none in a granule a resource
+ * left lately (recorded work may still use it: the trim's wait). `used`: its slots whose unit has a
+ * resource bound. */
+static bool
+radv_ps5_piece_movable(uint64_t piece, uint32_t now, uint32_t quarantine, uint32_t *used)
+{
+   *used = 0;
+   for (uint32_t mask = radv_ps5_slot_masks[piece]; mask; mask &= mask - 1) {
+      const uint32_t slot = (uint32_t)__builtin_ctz(mask);
+      const struct radv_ps5_slot *const shown = &radv_ps5_slots[piece * RADV_PS5_COMPACT_UNITS + slot];
+      const struct radv_ps5_memory *const memory = shown->memory;
+      if (!memory || memory == RADV_PS5_SLOT_HELD || memory->no_compact || !memory->unit_uses || !memory->released_ms)
+         return false;
+      const uint32_t granule = shown->unit / RADV_PS5_COMPACT_UNITS;
+      if (memory->released_ms[granule] && now - memory->released_ms[granule] < quarantine)
+         return false;
+      if (memory->unit_uses[shown->unit])
+         *used |= 1u << slot;
+   }
+   return true;
+}
+
+/* The units showing a piece's slots that have no resource bound show the zero block; the piece may go
+ * back with them. False: a mapping failed. */
+static bool
+radv_ps5_piece_drop_unused(uint64_t piece, int64_t zero, struct radv_ps5_compact_report *report)
+{
+   for (uint32_t mask = radv_ps5_slot_masks[piece]; mask; mask &= mask - 1) {
+      const uint32_t slot = (uint32_t)__builtin_ctz(mask);
+      const struct radv_ps5_slot shown = radv_ps5_slots[piece * RADV_PS5_COMPACT_UNITS + slot];
+      if (shown.memory->unit_uses[shown.unit])
+         continue;
+      if (!radv_ps5_units_map(shown.memory, shown.unit, 1, zero))
+         return false;
+      report->released += radv_ps5_unit_dropped(shown.memory, shown.unit);
+      report->dropped++;
+   }
+   return true;
+}
+
+/* A CPU view of a piece, for copying into slots no unit shows. */
+static uint8_t *
+radv_ps5_piece_view(uint64_t piece, uint8_t **view, uint64_t *view_piece)
+{
+   if (*view && *view_piece == piece)
+      return *view;
+   if (*view)
+      sceKernelMunmap(*view, RADV_PS5_LARGE_BYTES);
+   *view = NULL;
+   void *at = NULL;
+   if (sceKernelMapDirectMemory(&at, RADV_PS5_LARGE_BYTES, PS5_KERNEL_PROT_CPU_READ | PS5_KERNEL_PROT_CPU_WRITE, 0,
+                                (int64_t)(piece * RADV_PS5_LARGE_BYTES), RADV_PS5_LARGE_BYTES) != 0)
+      return NULL;
+   *view = at;
+   *view_piece = piece;
+   return *view;
+}
+
+#define RADV_PS5_COMPACT_PIECES 64
+#define RADV_PS5_COMPACT_NS UINT64_C(50000000)
+
+/* The CPU page tables a pass leaves free at least: a unit mapped inside what was one 2 MiB mapping
+ * takes a table of the title's 16,384, and past them the kernel refuses mappings with memory still
+ * free. Mario Kart World's Grand Prix ended with 1,996 free (2,654-3,250 before the compaction).
+ * RADV_PS5_COMPACT_TABLES overrides. */
+static int
+radv_ps5_compact_tables_mark(void)
+{
+   static int mark = -1;
+   if (mark < 0) {
+      const char *const text = getenv("RADV_PS5_COMPACT_TABLES");
+      mark = text ? atoi(text) : 2000;
+   }
+   return mark;
+}
+
+/* The pass that moves (radv_ps5_compact_pass): the GPU idle with nothing submitted, the trim lock held. */
+static void
+radv_ps5_compact_move(uint64_t want, struct radv_ps5_compact_report *report)
+{
+   const int64_t zero = radv_ps5_zero_block();
+   if (zero < 0 || radv_ps5_compact_broken)
+      return;
+   report->tables_free = radv_ps5_compact_tables_free();
+   if (report->tables_free >= 0 && report->tables_free < radv_ps5_compact_tables_mark()) {
+      report->tables_low = true;
+      return;
+   }
+   const uint64_t start = radv_ps5_now_ns();
+   for (uint32_t i = 0; i < radv_ps5_trim_count; ++i) {
+      if (!radv_ps5_trim_tracked[i]->unit_phys && radv_ps5_compact_manage(radv_ps5_trim_tracked[i]))
+         report->managed++;
+   }
+   if (!radv_ps5_slots)
+      return;
+   struct radv_ps5_compact_piece *const pieces = malloc(radv_ps5_piece_count * sizeof(*pieces));
+   uint32_t *const order = malloc(radv_ps5_piece_count * sizeof(*order));
+   struct radv_ps5_compact_move *const moves =
+      malloc(RADV_PS5_COMPACT_PIECES * (RADV_PS5_COMPACT_UNITS - 1) * sizeof(*moves));
+   uint8_t *view = NULL;
+   uint64_t view_piece = 0;
+   if (!pieces || !order || !moves)
+      goto done;
+   const uint32_t now = radv_ps5_trim_now_ms(), quarantine = radv_ps5_trim_quarantine_ms();
+   uint32_t count = 0;
+   for (uint64_t piece = 0; piece < radv_ps5_piece_count; ++piece) {
+      uint32_t used;
+      if (!radv_ps5_slot_masks[piece] || !radv_ps5_piece_movable(piece, now, quarantine, &used))
+         continue;
+      if (!used) {
+         /* Nothing bound over any unit showing it: it goes back without a copy. */
+         if (!radv_ps5_piece_drop_unused(piece, zero, report))
+            goto broken;
+         report->emptied++;
+         continue;
+      }
+      if (used == UINT32_MAX)
+         continue;
+      report->partial++;
+      report->partial_free += RADV_PS5_COMPACT_UNITS - (uint32_t)__builtin_popcount(used);
+      pieces[count++] = (struct radv_ps5_compact_piece){.used = used, .granule = (uint32_t)piece};
+   }
+   report->candidates = count;
+   if (!count)
+      goto done;
+   radv_ps5_compact_order(pieces, count, order);
+   uint32_t limit = (uint32_t)MIN2((want + RADV_PS5_LARGE_BYTES - 1) / RADV_PS5_LARGE_BYTES, RADV_PS5_COMPACT_PIECES);
+   if (!limit)
+      limit = 1;
+   uint32_t move_count = 0;
+   radv_ps5_compact_plan(pieces, order, count, limit, moves, &move_count);
+   uint32_t guest = UINT32_MAX;
+   for (uint32_t m = 0; m < move_count; ++m) {
+      const struct radv_ps5_compact_move *const move = &moves[m];
+      if (move->from != guest) {
+         /* A piece emptied: the units left showing it have nothing bound, and go too. */
+         if (guest != UINT32_MAX) {
+            if (!radv_ps5_piece_drop_unused(pieces[guest].granule, zero, report))
+               goto broken;
+            report->emptied++;
+         }
+         if (radv_ps5_now_ns() - start > RADV_PS5_COMPACT_NS) {
+            guest = UINT32_MAX;
+            report->timed_out = true;
+            break;
+         }
+         guest = move->from;
+      }
+      const uint64_t from_piece = pieces[move->from].granule, to_piece = pieces[move->to].granule;
+      const struct radv_ps5_slot from = radv_ps5_slots[from_piece * RADV_PS5_COMPACT_UNITS + move->from_unit];
+      const struct radv_ps5_slot to = radv_ps5_slots[to_piece * RADV_PS5_COMPACT_UNITS + move->to_unit];
+      uint8_t *const target_view = radv_ps5_piece_view(to_piece, &view, &view_piece);
+      if (!from.memory || !target_view)
+         goto broken;
+      if (to.memory) {
+         /* The slot's unit has nothing bound: it shows the zero block, and the slot takes the move. */
+         if (!radv_ps5_units_map(to.memory, to.unit, 1, zero))
+            goto broken;
+         radv_ps5_unit_dropped(to.memory, to.unit);
+         report->dropped++;
+      }
+      uint8_t *const source = radv_ps5_unit_address(from.memory, from.unit);
+      uint8_t *const copy = target_view + (uint64_t)move->to_unit * RADV_PS5_COMPACT_UNIT;
+      radv_ps5_cpu_flush(source, RADV_PS5_COMPACT_UNIT);
+      radv_ps5_compact_copy(copy, source);
+      radv_ps5_cpu_flush(copy, RADV_PS5_COMPACT_UNIT);
+      const int64_t target = radv_ps5_slot_physical(to_piece, move->to_unit);
+      if (!radv_ps5_units_map(from.memory, from.unit, 1, target))
+         goto broken;
+      from.memory->unit_phys[from.unit] = target;
+      radv_ps5_slot_set(target, from.memory, from.unit);
+      report->released += radv_ps5_slot_clear(radv_ps5_slot_physical(from_piece, move->from_unit));
+      report->moved++;
+   }
+   if (guest != UINT32_MAX) {
+      if (!radv_ps5_piece_drop_unused(pieces[guest].granule, zero, report))
+         goto broken;
+      report->emptied++;
+   }
+   goto done;
+broken:
+   radv_ps5_compact_broken = true;
+   fprintf(stderr, "radv/ps5: compaction: a mapping failed; no more passes\n");
+done:
+   if (view)
+      sceKernelMunmap(view, RADV_PS5_LARGE_BYTES);
+   free(pieces);
+   free(order);
+   free(moves);
+}
+
+/* The pass that only plans (radv_ps5_compact_pass's dry run): the granules of memory not yet managed. */
+static void
+radv_ps5_compact_dry(struct radv_ps5_compact_report *report)
+{
+   const uint32_t now = radv_ps5_trim_now_ms(), quarantine = radv_ps5_trim_quarantine_ms();
+   uint64_t total = 0;
+   for (uint32_t i = 0; i < radv_ps5_trim_count; ++i)
+      total += radv_ps5_trim_tracked[i]->bytes / RADV_PS5_LARGE_BYTES;
+   if (!total)
+      return;
+   struct radv_ps5_compact_piece *const pieces = malloc(total * sizeof(*pieces));
+   uint32_t *const order = malloc(total * sizeof(*order));
+   struct radv_ps5_compact_move *const moves = malloc(total * (RADV_PS5_COMPACT_UNITS - 1) * sizeof(*moves));
+   uint32_t count = 0;
+   for (uint32_t i = 0; pieces && order && moves && i < radv_ps5_trim_count; ++i) {
+      struct radv_ps5_memory *const memory = radv_ps5_trim_tracked[i];
+      if (memory->no_compact || !memory->unit_uses || memory->unit_phys)
+         continue;
+      const uint64_t granules = memory->bytes / RADV_PS5_LARGE_BYTES;
+      for (uint64_t g = 0; g < granules; ++g) {
+         if (!memory->uses[g] || (memory->pieces && memory->pieces[g] < 0))
+            continue;
+         uint32_t used = 0;
+         for (uint32_t u = 0; u < RADV_PS5_COMPACT_UNITS; ++u) {
+            if (memory->unit_uses[g * RADV_PS5_COMPACT_UNITS + u])
+               used |= 1u << u;
+         }
+         const uint32_t in_use = (uint32_t)__builtin_popcount(used);
+         if (in_use == 0 || in_use == RADV_PS5_COMPACT_UNITS)
+            continue;
+         report->partial++;
+         report->partial_free += RADV_PS5_COMPACT_UNITS - in_use;
+         if (memory->released_ms[g] && now - memory->released_ms[g] < quarantine)
+            continue;
+         pieces[count++] = (struct radv_ps5_compact_piece){.used = used, .memory = memory, .granule = (uint32_t)g};
+      }
+   }
+   report->candidates = count;
+   if (count) {
+      radv_ps5_compact_order(pieces, count, order);
+      report->emptied = radv_ps5_compact_plan(pieces, order, count, UINT32_MAX, moves, &report->moved);
+   }
+   free(pieces);
+   free(order);
+   free(moves);
+}
+
+/* A compaction pass (radv_ps5_eden_compact holds the submit lock with the GPU idle when it moves).
+ * Never waits for the trim lock: false when it is held. */
+bool
+radv_ps5_compact_pass(uint64_t want, bool dry, struct radv_ps5_compact_report *report)
+{
+   memset(report, 0, sizeof(*report));
+   if (!radv_ps5_trim_trylock())
+      return false;
+   if (dry)
+      radv_ps5_compact_dry(report);
+   else
+      radv_ps5_compact_move(want, report);
+   report->broken = radv_ps5_compact_broken;
+   radv_ps5_trim_release();
+   return true;
+}
