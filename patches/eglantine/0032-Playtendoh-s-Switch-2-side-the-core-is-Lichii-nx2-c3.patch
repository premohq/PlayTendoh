+--- a/src/video_core/gpu_split.cpp
++++ b/src/video_core/gpu_split.cpp
+@@ -1784,6 +1784,11 @@ void GpuSplit::BackLoop(std::stop_token stop_token) {
+                 hook_requested.store(false, std::memory_order_seq_cst);
+                 idle_hook(idle_argument);
+             }
++            if (between_entries_hook.load(std::memory_order_relaxed) != nullptr) [[unlikely]] {
++                if (auto* const hook = between_entries_hook.exchange(nullptr, std::memory_order_acq_rel)) {
++                    hook();
++                }
++            }
+             // Hand ring space back now and then while working through a long batch, and at once
+             // when the front waits for this position (WaitForWriters).
+             if ((read_position - last_store >= 4096 ||
