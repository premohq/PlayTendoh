-+                    memory.Write32(stream->buffer + ReadIndexOffset, (read + taken) % capacity);
-+                    filled -= taken;
-+                }
-+            }
-+            const u32 free_frames = capacity - 1 - filled;
-+            if (stream->data_event && stream->data_mode != 0 &&
