diff --git a/tools/eglantine-patches/0119-ps5-video-decoder-opens-with-one-thread-when-threads-are-refused.patch b/tools/eglantine-patches/0119-ps5-video-decoder-opens-with-one-thread-when-threads-are-refused.patch
new file mode 100644
index 0000000..ab91785
--- /dev/null
+++ b/tools/eglantine-patches/0119-ps5-video-decoder-opens-with-one-thread-when-threads-are-refused.patch
@@ -0,0 +1,53 @@
+The video decoder opens again with one thread when opening it with its threads fails: a fresh codec context with the same parameters (avcodec_parameters_from_context/to_context), flags and hardware device, thread_count 1. Mario Kart World's Grand Prix on the PS5 (20 Nov) configured a 2560x1440 VP9 video, avcodec_open2 gave EAGAIN (its slice threads refused, their stacks from a small pool), the decoder never opened and the game waited on a black screen.
+
+diff --git a/src/video_core/host1x/ffmpeg.cpp b/src/video_core/host1x/ffmpeg.cpp
+index 8c5fccf..b24d735 100644
+--- a/src/video_core/host1x/ffmpeg.cpp
++++ b/src/video_core/host1x/ffmpeg.cpp
+@@ -5,6 +5,7 @@
+ 
+ #include <cstring>
+ #include <string_view>
++#include <utility>
+ #include <vector>
+ 
+ #include "common/assert.h"
+@@ -318,7 +319,37 @@ bool DecoderContext::OpenContext(const Decoder& decoder, std::span<const u8> ext
+         m_codec_context->extradata_size = static_cast<int>(extradata.size());
+     }
+ 
+-    if (const int ret = avcodec_open2(m_codec_context, decoder.GetCodec(), nullptr); ret < 0) {
++    int ret = avcodec_open2(m_codec_context, decoder.GetCodec(), nullptr);
++    if (ret < 0 && m_codec_context->thread_count != 1) {
++        // EglantinePS5: its threads may be refused (EAGAIN: Mario Kart World's 1440p VP9 video
++        // on the PS5, 20 Nov, whose thread stacks share a small pool) and the game then waits on
++        // a video that never opened. One thread needs none: a fresh context with the same
++        // parameters and settings, opened again.
++        LOG_WARNING(HW_GPU, "avcodec_open2 error: {}; opening it again with one thread", AVError(ret));
++        AVCodecContext* single = avcodec_alloc_context3(decoder.GetCodec());
++        AVCodecParameters* parameters = avcodec_parameters_alloc();
++        if (single != nullptr && parameters != nullptr &&
++            avcodec_parameters_from_context(parameters, m_codec_context) >= 0 &&
++            avcodec_parameters_to_context(single, parameters) >= 0) {
++            av_opt_set(single->priv_data, "tune", "zerolatency", 0);
++            single->thread_count = 1;
++            single->thread_type = m_codec_context->thread_type;
++            single->flags = m_codec_context->flags;
++            single->flags2 = m_codec_context->flags2;
++            if (m_codec_context->hw_device_ctx != nullptr) {
++                single->hw_device_ctx = av_buffer_ref(m_codec_context->hw_device_ctx);
++                single->get_format = m_codec_context->get_format;
++                single->pix_fmt = m_codec_context->pix_fmt;
++            }
++            av_buffer_unref(&m_codec_context->hw_device_ctx);
++            avcodec_free_context(&m_codec_context);
++            m_codec_context = std::exchange(single, nullptr);
++            ret = avcodec_open2(m_codec_context, decoder.GetCodec(), nullptr);
++        }
++        avcodec_parameters_free(&parameters);
++        avcodec_free_context(&single);
++    }
++    if (ret < 0) {
+         LOG_ERROR(HW_GPU, "avcodec_open2 error: {}", AVError(ret));
+         return false;
+     }
diff --git a/tools/eglantine-patches/0120-ps5-layer-uploads-without-memory-go-back-to-the-dirty-layers.patch b/tools/eglantine-patches/0120-ps5-layer-uploads-without-memory-go-back-to-the-dirty-layers.patch
