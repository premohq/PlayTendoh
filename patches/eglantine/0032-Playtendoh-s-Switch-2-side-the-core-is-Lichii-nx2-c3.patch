++++ b/src/video_core/buffer_cache/buffer_cache.h
+@@ -3930,6 +3930,22 @@ BufferId BufferCache<P>::CreateBuffer(DAddr device_addr, u32 wanted_size, bool s
+     try {
+         new_buffer_id = slot_buffers.insert(runtime, overlap.begin, size, sparse_compatible);
+     } catch (const std::exception&) {
++        if constexpr (requires { runtime.RefusedBuffersAllowed(); }) {
++            // EglantinePS5: a binding's buffer (FindBindingBuffer) the host had no memory to
++            // record (Ocarina of Time loading Castle Town, 20 Nov: a 1 KiB uniform buffer ended
++            // the session) reads nothing this time, as one the device refused below; nothing was
++            // joined yet.
++            if (runtime.RefusedBuffersAllowed()) {
++                if (refused_buffers++ < 16) {
++                    LOG_WARNING(HW_GPU,
++                                "No host memory for a {} MiB buffer at {:#x} (for {:#x}+{:#x}) asked "
++                                "by {}: that binding reads nothing this time",
++                                size >> 20, overlap.begin, asked_addr, asked_size,
++                                caller.function_name());
++                }
++                return NULL_BUFFER_ID;
++            }
++        }
+         // EglantinePS5: which caller a refusal that ends the session came from, for the next fix
+         // (a draw's buffer in Ocarina of Time ended it through a path this did not name).
+         LOG_CRITICAL(HW_GPU, "No memory for a {} MiB buffer at {:#x} (for {:#x}+{:#x}) asked by {} "
+diff --git a/src/video_core/renderer_vulkan/vk_buffer_cache.h b/src/video_core/renderer_vulkan/vk_buffer_cache.h
