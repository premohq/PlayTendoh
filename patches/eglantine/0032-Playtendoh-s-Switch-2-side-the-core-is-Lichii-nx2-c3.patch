diff --git a/tools/eglantine-patches/0084-lichii-storage-size-word-cap.patch b/tools/eglantine-patches/0084-lichii-storage-size-word-cap.patch
new file mode 100644
index 0000000..9355183
--- /dev/null
+++ b/tools/eglantine-patches/0084-lichii-storage-size-word-cap.patch
@@ -0,0 +1,31 @@
+A native compute program's storage buffer takes the word after its pointer as a size when it is over
+8 MiB (Mario Kart World's lighting reads ~16 MiB). A word past 256 MiB is another value: Ocarina of
+Time's Kokiri Forest load has the float 1.0 (0x3F800000) there, and the 1 GiB buffer it asked for ran
+the PS5 out of memory (found by viejunerd/Eglantine-PS5- for its core). Such a binding is bare (8 MiB)
+and logged, 16 times at most.
+
+diff --git a/src/video_core/buffer_cache/buffer_cache.h b/src/video_core/buffer_cache/buffer_cache.h
+--- a/src/video_core/buffer_cache/buffer_cache.h
++++ b/src/video_core/buffer_cache/buffer_cache.h
+@@ -4404,8 +4404,20 @@
+                 // came back zero and lit land and characters too dark. A read-only compute binding
+                 // takes a larger size word. Binding to the end of the mapping instead spanned
+                 // Ocarina of Time's ~1 GiB heap and backed it with a 1 GiB buffer.
++                // A word past 256 MiB is another value, not a size: Ocarina's Kokiri Forest load has
++                // the float 1.0 (0x3F800000) there, and the 1 GiB buffer it asked for ran the PS5
++                // out of memory. Mario Kart World's largest real size word is about 16 MiB.
+                 if (compute && !is_written && next_qword_is_size && packed_size > bare) {
+-                    return (std::min)(packed_size, limit);
++                    if (packed_size <= static_cast<u32>(256_MiB)) {
++                        return (std::min)(packed_size, limit);
++                    }
++                    static std::atomic<u32> not_sizes{};
++                    if (not_sizes.fetch_add(1, std::memory_order_relaxed) < 16) {
++                        LOG_WARNING(HW_GPU,
++                                    "Storage buffer size word {:#x} at {:#x} is not a size: bound "
++                                    "as a bare pointer",
++                                    packed_size, ssbo_addr + 8);
++                    }
+                 }
+                 return bare;
+             }
diff --git a/tools/eglantine-patches/0085-ps5-four-pipeline-builders.patch b/tools/eglantine-patches/0085-ps5-four-pipeline-builders.patch
new file mode 100644
index 0000000..c52879e
--- /dev/null
+++ b/tools/eglantine-patches/0085-ps5-four-pipeline-builders.patch
@@ -0,0 +1,25 @@
+On the PS5, four pipeline builders instead of one per hardware thread but one (15): each holds its
+own compiler state, and fifteen took a cold launch's heap past 3 GiB in Ocarina of Time
+(Vampinity/Eglantine-PS5- measured it on its core) and took CPU time from the game. The driver's
+threads follow, at most these. EDEN_NX2_PIPELINE_WORKERS=<n> sets another count.
+
+diff --git a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
++++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+@@ -520,6 +520,16 @@
+         return 1ULL;
+     }
+     return std::min(max_core_threads, desired);
++#elif defined(__PROSPERO__)
++    // Each builder holds its own compiler state: on the PS5, 15 of them took a cold launch's heap past
++    // 3 GiB (Ocarina of Time) and took CPU time from the game. Four, as a warm launch needs; the
++    // driver's threads follow (at most these). EDEN_NX2_PIPELINE_WORKERS=<n> sets another count.
++    static const size_t workers = [max_core_threads] {
++        const char* value = std::getenv("EDEN_NX2_PIPELINE_WORKERS");
++        const size_t wanted = value != nullptr ? std::strtoull(value, nullptr, 10) : 4;
++        return std::clamp<size_t>(wanted, 1, max_core_threads);
++    }();
++    return workers;
+ #else
+     return max_core_threads;
+ #endif
