++// ReadBlockUnsafe, and read-only GuestMemory spans) go through these. The PS5 layer's guest memory
++// service (src/guest_memory_service.inc) sets them: while a load leaves the console's pool short,
++// a read of a slot whose memory is packed is copied from its packed bytes, instead of faulting the
++// slot back in, which takes a 2 MiB block. A graphics thread waiting there for a block was the
++// only thread that could free one (Ocarina of Time loading Castle Town on the PS5, 20 Nov). Unset,
++// a read is the same memcpy after one relaxed load.
++namespace Common::GuestReadThrough {
++
++/// Copies `size` bytes from guest memory at `src` to `dest`
++inline std::atomic<void (*)(void* dest, const void* src, std::size_t size)> copy_fn{nullptr};
++/// Whether a span over [src, src + size) would read packed memory now (it is not handed out)
++inline std::atomic<bool (*)(const void* src, std::size_t size)> covers_packed_fn{nullptr};
++
++inline void Copy(void* dest, const void* src, std::size_t size) {
++    if (const auto fn = copy_fn.load(std::memory_order_relaxed)) {
++        fn(dest, src, size);
++    } else {
++        std::memcpy(dest, src, size);
++    }
++}
++
++inline bool CoversPacked(const void* src, std::size_t size) {
++    const auto fn = covers_packed_fn.load(std::memory_order_relaxed);
++    return fn != nullptr && fn(src, size);
++}
++
++} // namespace Common::GuestReadThrough
