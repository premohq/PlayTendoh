+--- a/src/video_core/gpu_split.h
++++ b/src/video_core/gpu_split.h
+@@ -669,6 +669,19 @@ public:
+         wake.fetch_add(1, std::memory_order_seq_cst);
+         wake.notify_one();
+     }
++    /// EglantinePS5, any thread: has the back run `hook` once, at its next step between entries
++    /// while it works through them (not while it is quiet, when the front may use the scheduler).
++    /// For work that must not wait behind the GPU work queued before it: the PS5's give-back of
++    /// graphics memory sat behind a full queue until a write of the game's memory found no block
++    /// and the session ended (Ocarina of Time loading Castle Town, 20 Nov).
