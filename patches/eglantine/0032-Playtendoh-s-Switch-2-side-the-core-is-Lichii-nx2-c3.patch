++++ b/src/video_core/buffer_cache/buffer_cache.h
+@@ -3229,10 +3229,20 @@ void BufferCache<P>::UpdateIndexBuffer() {
+         channel_state->index_buffer = NULL_BINDING;
+         return;
+     }
++    const BufferId buffer_id = FindBindingBuffer(*device_addr, size, false);
++    if (buffer_id == NULL_BUFFER_ID) {
++        // No memory for its buffer (FindBindingBuffer; Ocarina of Time loading Castle Town on the
++        // PS5, a 13 KiB index range with the device full): the draw is left out
++        // (TakeRefusedIndexBuffer), and the next one asks again.
++        channel_state->index_buffer = NULL_BINDING;
++        flags[Dirty::IndexBuffer] = true;
++        index_buffer_refused = true;
++        return;
++    }
+     channel_state->index_buffer = Binding{
+         .device_addr = *device_addr,
+         .size = size,
+-        .buffer_id = FindBuffer(*device_addr, size, false),
++        .buffer_id = buffer_id,
+     };
+ }
+ 
