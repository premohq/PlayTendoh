-+            return std::nullopt;
-+        }
-+        const std::optional<IdBound> low{Evaluate(addr->value, 0)};
-+        if (!low || low->base != 1 || guard_failed) {
-+            return std::nullopt;
-+        }
-+        // Below zero, invocation 0's offset wraps modulo 2^32 (see IdBound).
-+        const s64 start{low->c + addr->imm_offset};
