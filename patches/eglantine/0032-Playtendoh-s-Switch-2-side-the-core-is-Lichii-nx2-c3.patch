diff --git a/tools/eglantine-patches/0090-ps5-vma-8mib-blocks.patch b/tools/eglantine-patches/0090-ps5-vma-8mib-blocks.patch
new file mode 100644
index 0000000..0b128f4
--- /dev/null
+++ b/tools/eglantine-patches/0090-ps5-vma-8mib-blocks.patch
@@ -0,0 +1,24 @@
+On the PS5 VMA's blocks are 8 MiB instead of 16. The game's memory and the GPU's share one 12 GiB
+pool, and the driver gives memory back only in whole 2 MiB pieces nothing is bound over; Ocarina of
+Time ran out in Kokiri Forest with 455 MiB of holes in its 16 MiB blocks. Fewer allocations a block
+drain it sooner, and VMA then frees it whole. Allocations over 4 MiB get their own memory.
+
+diff --git a/src/video_core/vulkan_common/vulkan_device.cpp b/src/video_core/vulkan_common/vulkan_device.cpp
+--- a/src/video_core/vulkan_common/vulkan_device.cpp
++++ b/src/video_core/vulkan_common/vulkan_device.cpp
+@@ -1008,7 +1008,15 @@
+             // after ten minutes, with 32 MiB ones ~0.5 GB: a block drains only once all of its
+             // images are gone, and fewer per block drain sooner. VMA gives allocations over half a
+             // block (8 MiB) their own memory, which goes back to the driver when they are freed.
++#ifdef __PROSPERO__
++            // 8 MiB on the PS5, where the game's memory and the GPU's share one 12 GiB pool and
++            // the driver gives memory back only in whole 2 MiB pieces nothing is bound over:
++            // Ocarina of Time ran out with 455 MiB of holes in its 16 MiB blocks, most of them in
++            // pieces something still used. Allocations over 4 MiB get their own memory.
++            .preferredLargeHeapBlockSize = 8u * 1024u * 1024u,
++#else
+             .preferredLargeHeapBlockSize = 16u * 1024u * 1024u,
++#endif
+             .pAllocationCallbacks = nullptr,
+             .pDeviceMemoryCallbacks = nullptr,
+             .pHeapSizeLimit = heap_size_limit != 0 ? heap_size_limits.data() : nullptr,
