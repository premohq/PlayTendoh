+On the PS5 the descriptor update queues start at an eighth of their size and grow as frames need,
+up to the same limit (Acquire's growth path). The heap backs a new block with the pool games run short
+of: the guest queue took 96 MiB and the compute one 24 MiB at the start, while no Ocarina of Time or
+Mario Kart World session needed them to grow (viejunerd/Eglantine-PS5- estimated the same on its core).
+
+diff --git a/src/video_core/renderer_vulkan/vk_update_descriptor.cpp b/src/video_core/renderer_vulkan/vk_update_descriptor.cpp
+--- a/src/video_core/renderer_vulkan/vk_update_descriptor.cpp
++++ b/src/video_core/renderer_vulkan/vk_update_descriptor.cpp
+@@ -18,12 +18,27 @@
+ 
+ namespace Vulkan {
+ 
++#ifdef __PROSPERO__
++// On the PS5 the queues start at an eighth of their size and grow as frames need (Acquire), up to
++// the same limit: the heap backs all of a new block with the memory games run short of, and the
++// guest queue took 96 MiB (24 MiB the compute one) at its start, while no Ocarina of Time or Mario
++// Kart World session needed it to grow.
++constexpr size_t StartingPayloadSize(size_t size) {
++    return (std::max)(size / 8, size_t{0x2000});
