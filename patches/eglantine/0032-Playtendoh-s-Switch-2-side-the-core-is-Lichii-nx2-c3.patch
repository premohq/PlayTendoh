diff --git a/tools/eglantine-patches/0088-ps5-staging-reserve.patch b/tools/eglantine-patches/0088-ps5-staging-reserve.patch
new file mode 100644
index 0000000..35eb234
--- /dev/null
+++ b/tools/eglantine-patches/0088-ps5-staging-reserve.patch
@@ -0,0 +1,195 @@
+On the PS5 the staging pool keeps a reserve: a 16 MiB GPU-only, an 8 MiB upload and an 8 MiB download
+buffer, made at start while there is room. Requests of their size reuse them whenever they are free,
+the pool's sweeps never give them back, and a request that finds no new memory takes a free one big
+enough (waiting for submitted work if one is still in use) before the stream buffer and the refusal.
+Once staging memory is refused, ordinary requests leave the reserve alone for 1,000 submissions, so
+it is free for the next refusal (it was busy with the frame being recorded each time it was needed).
+Ocarina of Time ended on refused staging buffers late in sessions (ASTC copies, a 2D blit's read).
+
+diff --git a/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp b/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp
+index 6fd1863358..e1d55659e0 100644
+--- a/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp
++++ b/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp
+@@ -5,6 +5,7 @@
+ 
+ #include <algorithm>
+ #include <initializer_list>
++#include <array>
+ #include <utility>
+ #include <vector>
+ 
+@@ -125,6 +126,91 @@ StagingBufferPool::StagingBufferPool(const Device& device_, MemoryAllocator& mem
+     }
+     stream_pointer = stream_buffer.Mapped();
+     ASSERT_MSG(!stream_pointer.empty(), "Stream buffer must be host visible!");
++    MakeReserve();
++}
++
++// On the PS5 the game, the driver and the emulator share one 12 GiB pool, and late in a heavy
++// session it can be empty when a copy needs a staging buffer: nothing caught the refusal, and the
++// session ended (Ocarina of Time: an ASTC upload's 48 MiB copy, a 2D blit's 1 MiB read-back). A
++// buffer of each kind is made here, while there is room, and kept: requests of its size reuse it
++// whenever it is free, as any other, and one that finds no new memory takes it (TakeReserve).
++// 32 MiB in all: it is held for the whole session, and was never taken in three sessions at 96 MiB;
++// an ASTC image with no staging buffer is uploaded later instead (core patch 0087).
++void StagingBufferPool::MakeReserve() {
++#ifdef __PROSPERO__
++    // Lichii's buffer-side pool (EDEN_NX2_BUFFER_ARENA, ticked by the arena's stamps) keeps
++    // none: the reserve is the scheduler's pool's.
++    if (clock != nullptr) {
++        return;
++    }
++    constexpr std::array<std::pair<MemoryUsage, size_t>, 3> reserve{{
++        {MemoryUsage::DeviceLocal, size_t{16} << 20},
++        {MemoryUsage::Upload, size_t{8} << 20},
++        {MemoryUsage::Download, size_t{8} << 20},
++    }};
++    for (const auto& [usage, bytes] : reserve) {
++        try {
++            const StagingBufferRef ref = CreateStagingBuffer(bytes, usage, false);
++            auto& entries = GetCache(usage)[ref.log2_level].entries;
++            for (auto& entry : entries) {
++                if (entry.index == ref.index) {
++                    entry.reserved = true;
++                    entry.tick = 0;
