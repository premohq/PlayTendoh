+// The hang report. Mario Kart World stopped making frames at the PS5's memory wall (19 Nov):
+// every log stopped and nothing crashed, so nothing said where it was stuck. A watching thread
+// asks each named thread in turn, by SIGUSR1, for where it is: the handler runs on that thread
+// and lists its stack as a crash report does. One thread at a time (the stack reads share the
+// probe pipe); one that does not answer within 300 ms (signals blocked, or held in the kernel)
+// is listed as such, and a late answer finds itself no longer asked.
+constexpr std::uintptr_t kHangTaken = 1;
+std::atomic<std::uintptr_t> hang_target{0};
+std::atomic<bool> hang_answered{false};
+Text<128 * 1024> hang;
+Text<64> hang_name;
+Text<300> hang_path;
+Text<300> hang_note;
+std::uint64_t hang_words[512];
+
+void HangSignal(int, siginfo_t*, void* context) {
+    const int saved_errno = errno;
+    std::uintptr_t expected = (std::uintptr_t)pthread_self();
+    if (hang_target.compare_exchange_strong(expected, kHangTaken, std::memory_order_acq_rel)) {
+        const Registers r = FromContext(context);
+        hang.Put("  at ");
+        hang.Address(r.rip);
+        hang.Put("\n");
+        PutCalls(hang, r.rsp, 24, hang_words);
+        hang_answered.store(true, std::memory_order_release);
+    }
+    errno = saved_errno;
+}
+
+void PutStamp(Text<128 * 1024>& t, const Stamp& stamp) noexcept;
+bool WriteFile(const char* path, const char* data, std::size_t size) noexcept;
+
+// One report at a time: the hang watch and a write waiting for memory (eden_threads_report) share
+// the buffers above; the later one is left out.
+std::atomic_flag threads_report_busy = ATOMIC_FLAG_INIT;
+bool hang_signal_ready = false;
+
+// `kind` names the file (kind-YYYYMMDD-HHMMSS.txt) and the report; `tag` starts its kernel log line.
+void ReportThreads(const char* kind, const char* tag, const char* what) noexcept {
+    if (!hang_signal_ready || threads_report_busy.test_and_set(std::memory_order_acq_rel)) return;
+    const Stamp stamp = LocalNow();
+    hang.Clear();
+    hang.Put("EglantinePS5 ");
+    hang.Put(kind);
+    hang.Put(" report\nversion: ");
+    hang.Put(version);
+    hang.Put("\ntime: ");
+    PutStamp(hang, stamp);
+    hang.Put(", ");
+    hang.Dec(static_cast<std::uint64_t>(std::time(nullptr) - started_at));
+    hang.Put(" s after the app started\nwhat: ");
+    hang.Put(what);
+    hang.Put("\nrunning: ");
+    hang.Put(sessions[session_now.load(std::memory_order_acquire) & 1]);
+    hang.Put("\ncode: 0x");
+    hang.Hex(CodeStart(), 16);
+    hang.Put(" (eboot+offset is an address in the build's llvm-pie.elf)\n");
+    hang.Put("each named thread: where it was, then the app's code addresses on its stack, most "
+             "recent first (\"?\": not checked against a call instruction)\n");
+    const auto self = (std::uintptr_t)pthread_self();
+    const unsigned count = std::min(named_thread_count.load(std::memory_order_acquire), kNamedThreads);
+    unsigned asked = 0, answered = 0;
+    for (unsigned i = 0; i < count; ++i) {
+        const std::uintptr_t thread = named_threads[i].thread.load(std::memory_order_acquire);
+        if (thread == 0 || thread == self) continue;
+        hang.Put("thread ");
+        hang.Put(named_threads[i].name);
+        hang.Put(" (0x");
+        hang.Hex(thread);
+        hang.Put(")\n");
+        hang_answered.store(false, std::memory_order_release);
+        hang_target.store(thread, std::memory_order_release);
+        ++asked;
+        if (pthread_kill((pthread_t)thread, SIGUSR1) != 0) {
+            hang_target.store(0, std::memory_order_release);
+            hang.Put("  gone\n");
+            continue;
+        }
+        for (int wait = 0; wait < 30 && !hang_answered.load(std::memory_order_acquire); ++wait) Sleep(10000);
+        std::uintptr_t expected = thread;
+        if (hang_target.compare_exchange_strong(expected, 0, std::memory_order_acq_rel)) {
+            hang.Put("  no answer (signals blocked, or held in the kernel)\n");
+            continue;
+        }
+        // Its handler is writing: wait for it to finish before asking the next thread.
+        for (int wait = 0; wait < 200 && !hang_answered.load(std::memory_order_acquire); ++wait) Sleep(10000);
+        if (!hang_answered.load(std::memory_order_acquire)) {
+            hang.Put("  (the report ends here: this thread did not finish its answer)\n");
+            break;
+        }
+        hang_target.store(0, std::memory_order_release);
+        ++answered;
+    }
+    hang_name.Clear();
+    hang_name.Put(kind);
+    hang_name.Put('-');
+    hang_name.Dec(static_cast<std::uint64_t>(stamp.year), 4);
+    hang_name.Dec(stamp.month, 2);
+    hang_name.Dec(stamp.day, 2);
+    hang_name.Put('-');
+    hang_name.Dec(stamp.hour, 2);
+    hang_name.Dec(stamp.minute, 2);
+    hang_name.Dec(stamp.second, 2);
+    hang_name.Put(".txt");
+    hang_path.Clear();
+    hang_path.Put(logs);
+    hang_path.Put('/');
+    hang_path.Put(hang_name.data);
+    const bool saved = WriteFile(hang_path.data, hang.data, hang.size);
+    hang_note.Clear();
+    hang_note.Put(tag);
+    hang_note.Put(' ');
+    hang_note.Put(what);
+    hang_note.Put("; threads asked ");
+    hang_note.Dec(asked);
+    hang_note.Put(", answered ");
+    hang_note.Dec(answered);
+    hang_note.Put(saved ? "; report=" : "; report_not_written=");
+    hang_note.Put(hang_path.data);
+    hang_note.Put("\n");
+    Note(hang_note.data);
+    (void)!write(2, hang_note.data, hang_note.size);
+    threads_report_busy.clear(std::memory_order_release);
+}
+
+void ReportHang(unsigned seconds) noexcept {
+    Text<64> what;
+    what.Clear();
+    what.Put("no frame for ");
+    what.Dec(seconds);
+    what.Put(" s");
+    ReportThreads("hang", "EDEN_HANG", what.data);
+}
+
+// Counts whole seconds without a new frame once the game has made one. A sleep that took far
+// longer than asked (the app suspended at the console's home screen) starts the count over.
+void HangWatch() {
+    std::uint64_t last = frames_presented.load(std::memory_order_relaxed);
+    unsigned still = 0, reports = 0;
+    for (;;) {
+        const std::time_t before = std::time(nullptr);
+        Sleep(1000000);
+        const std::uint64_t now = frames_presented.load(std::memory_order_relaxed);
+        const bool suspended = std::time(nullptr) - before > 3;
+        if (now != last || now == 0 || suspended || state.load(std::memory_order_acquire) != kIdle) {
+            last = now;
+            still = 0;
+            continue;
+        }
+        ++still;
+        if ((still == 20 || still == 60) && reports < 6) {
+            ++reports;
+            ReportHang(still);
+        }
+    }
+}
