 void CopyText(char* target, std::size_t size, const char* text) noexcept {
     std::size_t length = 0;
     for (; text && text[length] && length + 1 < size; ++length) target[length] = text[length];
@@ -567,11 +755,29 @@ void Install(const std::string& logs_folder, const char* app_version, bool resta
     sigemptyset(&action.sa_mask);
     unsigned handled = 0;
     for (const Kind& kind : kKinds) handled += sigaction(kind.signal, &action, nullptr) == 0;
+    struct sigaction hang_action {};
+    hang_action.sa_sigaction = HangSignal;
+    hang_action.sa_flags = SA_SIGINFO | SA_RESTART;
+    sigemptyset(&hang_action.sa_mask);
+    hang_signal_ready = probe && sigaction(SIGUSR1, &hang_action, nullptr) == 0;
+    if (hang_signal_ready) std::thread(HangWatch).detach();
     installed = true;
     std::fprintf(stderr, "EDEN_CRASH_REPORT installed=1 signals=%u stack_reads=%d folder=%s after_crash=%d\n", handled,
                  probe ? 1 : 0, logs, restarted ? 1 : 0);
 }
 
+} // namespace Eden::Crash
+
+// Where every named thread is now (logs/threads-YYYYMMDD-HHMMSS.txt and an EDEN_THREADS line), for a
+// moment worth seeing that is no crash: src/guest_memory_service.inc calls it when a write to the
+// game's memory has waited 3 s for a block. Safe in a signal handler; nothing while a crash or
+// another such report is being written.
+extern "C" void eden_threads_report(const char* why) {
+    if (Eden::Crash::state.load(std::memory_order_acquire) != Eden::Crash::kIdle) return;
+    Eden::Crash::ReportThreads("threads", "EDEN_THREADS", why);
+}
