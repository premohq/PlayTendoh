+            t.Dec(static_cast<unsigned>(cpu_tables));
+            t.Put(", GPU ");
+            t.Dec(static_cast<unsigned>(gpu_free));
+            t.Put(" of ");
+            t.Dec(static_cast<unsigned>(gpu_tables));
+        }
+        t.Put("\n");
     }
 #endif
     t.Put("registers:");
@@ -523,6 +697,20 @@ void Flusher() {
     std::fflush(stdout);
 }
 
+void PutStamp(Text<128 * 1024>& t, const Stamp& stamp) noexcept {
+    t.Dec(static_cast<std::uint64_t>(stamp.year), 4);
+    t.Put('-');
+    t.Dec(stamp.month, 2);
+    t.Put('-');
+    t.Dec(stamp.day, 2);
+    t.Put(' ');
+    t.Dec(stamp.hour, 2);
+    t.Put(':');
+    t.Dec(stamp.minute, 2);
+    t.Put(':');
+    t.Dec(stamp.second, 2);
+}
