+// A thread stuck three calls deep (the hang report).
+[[gnu::noinline]] void HangInner(volatile int* stop) {
+    while (!*stop) usleep(1000);
+    sink = 4;
+}
+[[gnu::noinline]] void HangMiddle(volatile int* stop) {
+    HangInner(stop);
+    sink = 5;
+}
+[[gnu::noinline]] void HangOuter(volatile int* stop) {
+    HangMiddle(stop);
+    sink = 6;
+}
+
+static int HangCheck() {
+    static volatile int stop = 0;
+    std::thread stuck([] {
+        Eden::Crash::NameThread("GPU");
+        HangOuter(&stop);
+    });
+    std::thread blocked([] {
+        Eden::Crash::NameThread("Blocked");
+        sigset_t all;
+        sigfillset(&all);
+        pthread_sigmask(SIG_BLOCK, &all, nullptr);
+        while (!stop) usleep(1000);
+    });
+    Eden::Crash::NoteFrame();  // one frame, then none
+    std::this_thread::sleep_for(std::chrono::seconds(23));
+    stop = 1;
+    stuck.join();
+    blocked.join();
+    std::puts("HANG_DONE");
+    return 0;
+}
+
+extern "C" void eden_threads_report(const char* why);
+static int ThreadsCheck() {
+    static volatile int stop = 0;
+    std::thread stuck([] {
+        Eden::Crash::NameThread("GPU");
+        HangOuter(&stop);
+    });
+    usleep(200000);
+    eden_threads_report("a test moment");
+    stop = 1;
+    stuck.join();
+    std::puts("THREADS_DONE");
+    return 0;
+}
