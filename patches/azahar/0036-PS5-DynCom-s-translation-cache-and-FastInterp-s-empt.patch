From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Phononenom <64574232+Phononenom@users.noreply.github.com>
Date: Sat, 21 Nov 2026 21:10:27 -0600
Subject: [PATCH] PS5: DynCom's translation cache and FastInterp's empty page
 table from the heap

Both were arrays in .bss: 125 MiB and 8 MiB of the app's image, which the PS5 keeps in flexible memory
for every side, a 3DS game or not. Each now comes from the heap (direct memory) while a core that uses
it exists: the first DynCom or FastInterp core made allocates it, the last one destroyed gives it back.
Dynarmic, the JIT, uses neither, so a 3DS game on the JIT allocates neither.
---
 src/core/arm/dyncom/arm_dyncom.cpp       |  5 +++-
 src/core/arm/dyncom/arm_dyncom_trans.cpp | 22 +++++++++++++++-
 src/core/arm/dyncom/arm_dyncom_trans.h   |  5 +++-
 src/core/arm/fastinterp/fastinterp.cpp   | 33 ++++++++++++++++++++----
 4 files changed, 57 insertions(+), 8 deletions(-)

diff --git a/src/core/arm/dyncom/arm_dyncom.cpp b/src/core/arm/dyncom/arm_dyncom.cpp
index d1a6c382e..a48dcee73 100644
--- a/src/core/arm/dyncom/arm_dyncom.cpp
+++ b/src/core/arm/dyncom/arm_dyncom.cpp
@@ -18,10 +18,13 @@ ARM_DynCom::ARM_DynCom(Core::System& system_, Memory::MemorySystem& memory,
                        PrivilegeMode initial_mode, u32 id,
                        std::shared_ptr<Core::Timing::Timer> timer)
     : ARM_Interface(id, timer), system(system_) {
+    TransCacheAcquire();
     state = std::make_unique<ARMul_State>(system, memory, initial_mode);
 }
 
-ARM_DynCom::~ARM_DynCom() {}
+ARM_DynCom::~ARM_DynCom() {
+    TransCacheRelease();
+}
 
 void ARM_DynCom::Run() {
     if (break_flag) [[unlikely]] {
diff --git a/src/core/arm/dyncom/arm_dyncom_trans.cpp b/src/core/arm/dyncom/arm_dyncom_trans.cpp
index 729c40797..d9532aff9 100644
--- a/src/core/arm/dyncom/arm_dyncom_trans.cpp
+++ b/src/core/arm/dyncom/arm_dyncom_trans.cpp
@@ -6,8 +6,28 @@
 #include "core/arm/skyeye_common/armsupp.h"
 #include "core/arm/skyeye_common/vfp/vfp.h"
 
-char trans_cache_buf[TRANS_CACHE_SIZE];
+// The cache comes from the heap while a DynCom core exists, not with the program: 125 MiB of .bss
+// the app's image would hold in flexible memory for every side. The cores share it, so the first
+// one made allocates it and the last one destroyed gives it back.
+char* trans_cache_buf = nullptr;
 size_t trans_cache_buf_top = 0;
+static unsigned trans_cache_users = 0;
+
+void TransCacheAcquire() {
+    if (trans_cache_users++ == 0) {
+        trans_cache_buf = static_cast<char*>(std::malloc(TRANS_CACHE_SIZE));
+        ASSERT_MSG(trans_cache_buf != nullptr, "No memory for the translation cache");
+        trans_cache_buf_top = 0;
+    }
+}
+
+void TransCacheRelease() {
+    if (--trans_cache_users == 0) {
+        std::free(trans_cache_buf);
+        trans_cache_buf = nullptr;
+        trans_cache_buf_top = 0;
+    }
+}
 
 static void* AllocBuffer(std::size_t size) {
     std::size_t start = trans_cache_buf_top;
diff --git a/src/core/arm/dyncom/arm_dyncom_trans.h b/src/core/arm/dyncom/arm_dyncom_trans.h
index e67df4249..cdee879dc 100644
--- a/src/core/arm/dyncom/arm_dyncom_trans.h
+++ b/src/core/arm/dyncom/arm_dyncom_trans.h
@@ -494,5 +494,8 @@ extern const transop_fp_t arm_instruction_trans[];
 extern const std::size_t arm_instruction_trans_len;
 
 #define TRANS_CACHE_SIZE (64 * 1024 * 2000)
-extern char trans_cache_buf[TRANS_CACHE_SIZE];
+extern char* trans_cache_buf;
+// The cache's lifetime: ARM_DynCom's constructor and destructor (arm_dyncom_trans.cpp)
+void TransCacheAcquire();
+void TransCacheRelease();
 extern std::size_t trans_cache_buf_top;
diff --git a/src/core/arm/fastinterp/fastinterp.cpp b/src/core/arm/fastinterp/fastinterp.cpp
index 00b2bb9b5..fe797175c 100644
--- a/src/core/arm/fastinterp/fastinterp.cpp
+++ b/src/core/arm/fastinterp/fastinterp.cpp
@@ -4,8 +4,10 @@
 
 #include <bit>
 #include <cmath>
+#include <cstdlib>
 #include <cstring>
 
+#include "common/assert.h"
 #include "common/atomic_ops.h"
 #include "common/logging/log.h"
 #include "core/arm/dynarmic/arm_tick_counts.h"
@@ -18,10 +20,28 @@
 namespace Core::FastInterp {
 
 // Never-null page table. When no page table is set, page_pointers points at
-// this zero-initialized array (8MB of BSS nullptrs, zero-fill-on-demand, touched
-// only if the guest runs without a page table), so the MEM_* fast paths and the
-// unmapped-PC check never need a null test on the array itself.
-static u8* empty_page_table[1 << (32 - FASTINTERP_PAGE_BITS)];
+// this zero-initialized array of nullptrs, so the MEM_* fast paths and the
+// unmapped-PC check never need a null test on the array itself. Its 8 MiB come
+// from the heap while a FastInterp core exists, not with the program (the app's
+// image sits in flexible memory for every side): the first core made allocates
+// it, the last one destroyed gives it back.
+static constexpr std::size_t EMPTY_PAGE_TABLE_ENTRIES = 1 << (32 - FASTINTERP_PAGE_BITS);
+static u8** empty_page_table = nullptr;
+static unsigned empty_page_table_users = 0;
+
+static void EmptyPageTableAcquire() {
+    if (empty_page_table_users++ == 0) {
+        empty_page_table = static_cast<u8**>(std::calloc(EMPTY_PAGE_TABLE_ENTRIES, sizeof(u8*)));
+        ASSERT_MSG(empty_page_table != nullptr, "No memory for FastInterp's empty page table");
+    }
+}
+
+static void EmptyPageTableRelease() {
+    if (--empty_page_table_users == 0) {
+        std::free(empty_page_table);
+        empty_page_table = nullptr;
+    }
+}
 
 // Included inside the namespace: the macros reference LazyFlags and CondPassed.
 #ifdef __aarch64__
@@ -39,10 +59,13 @@ ARM_FastInterp::ARM_FastInterp(Core::System& system, Memory::MemorySystem& memor
     state_.fpscr = 0;
     state_.fpexc = 0;
     state_.thumb_mode = false;
+    EmptyPageTableAcquire();
     state_.page_pointers = empty_page_table; // Never null
 }
 
-ARM_FastInterp::~ARM_FastInterp() = default;
+ARM_FastInterp::~ARM_FastInterp() {
+    EmptyPageTableRelease();
+}
 
 // Log each unique unhandled encoding once: a bad decode in a loop would
 // otherwise flood the log on every block entry.
